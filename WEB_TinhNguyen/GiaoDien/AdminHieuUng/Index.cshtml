@model IEnumerable<WEB_TinhNguyen.MoHinh.ThuVienHieuUng>
@{
    ViewData["Title"] = "Kho Hiệu Ứng Web";
    Layout = "~/GiaoDien/Shared/_AdminLayout.cshtml";
}

<div class="mb-6 flex items-center justify-between">
    <div>
        <h2 class="text-2xl font-extrabold text-gray-900 tracking-tight">Kho Hiệu Ứng Trang Chủ</h2>
        <p class="text-sm text-gray-500 mt-1">Thêm các file Javascript chứa hiệu ứng (Hoa mai, tuyết rơi...) để gắn vào trang chủ.</p>
    </div>
    <button type="button" onclick="openModal()" class="bg-[#1b5e20] text-white px-5 py-2.5 rounded-xl shadow-md font-bold transition hover:bg-green-800">
        <i class="fas fa-magic mr-2"></i> Thêm Hiệu Ứng Mới
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="mb-6 p-4 text-emerald-800 border border-emerald-200 rounded-xl bg-emerald-50 shadow-sm font-semibold">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
    </div>
}

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    @foreach (var item in Model)
    {
        <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm relative group hover:shadow-md transition">
            <div class="flex justify-between items-start mb-4">
                <div class="h-12 w-12 rounded-xl bg-green-50 text-[#2e7d32] flex items-center justify-center text-xl font-bold">✨</div>
                <form asp-action="Delete" asp-route-id="@item.IDHieuUng" method="post" onsubmit="return confirm('Xóa hiệu ứng này?');">
                    <button type="submit" class="text-red-400 hover:text-red-600 bg-red-50 p-2 rounded-lg"><i class="fas fa-trash"></i></button>
                </form>
            </div>
            <h3 class="text-lg font-bold text-gray-800">@item.TenHieuUng</h3>
            <p class="text-sm text-gray-500 mt-1 line-clamp-2">@item.MoTa</p>
            <div class="mt-4 pt-4 border-t border-gray-100">
                <span class="text-xs font-semibold bg-gray-100 text-gray-600 px-3 py-1 rounded-md">File: @System.IO.Path.GetFileName(item.LinkFileJS)</span>
            </div>
        </div>
    }
</div>

<!-- Modal Thêm/Sửa Hiệu Ứng -->
<div id="hieuUngModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 backdrop-blur-sm px-4">
    <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="bg-[#1b5e20] p-5 flex justify-between items-center text-white">
            <h3 class="font-bold text-lg">Tải lên Hiệu ứng (.JS)</h3>
            <button onclick="closeModal()" class="hover:text-gray-300"><i class="fas fa-times"></i></button>
        </div>
        <form asp-action="Save" method="post" enctype="multipart/form-data" class="p-6 space-y-4">
            <input type="hidden" name="IDHieuUng" value="0" />
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Tên hiệu ứng (VD: Hoa Mai Rơi)</label>
                <input type="text" name="TenHieuUng" required class="w-full border rounded-xl p-3 outline-none focus:border-green-500" />
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Mô tả ngắn</label>
                <textarea name="MoTa" rows="2" class="w-full border rounded-xl p-3 outline-none focus:border-green-500"></textarea>
            </div>
            <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                <label class="block text-sm font-bold text-gray-700 mb-2">File Mã Lệnh (.JS)</label>
                <input type="file" name="FileJS" accept=".js" required class="w-full text-sm" />
                <p class="text-xs text-red-500 mt-2 font-medium">Lưu ý: Chỉ chấp nhận file code Javascript định dạng .js</p>
            </div>
            <div class="mt-6 flex justify-end gap-3">
                <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl font-bold bg-gray-100 text-gray-600">Hủy</button>
                <button type="submit" class="px-6 py-2.5 rounded-xl font-bold bg-[#2e7d32] text-white">Lưu Hiệu Ứng</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openModal() { document.getElementById('hieuUngModal').classList.replace('hidden', 'flex'); }
        function closeModal() { document.getElementById('hieuUngModal').classList.replace('flex', 'hidden'); }
    </script>
}