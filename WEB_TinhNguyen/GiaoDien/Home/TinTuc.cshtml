@model WEB_TinhNguyen.MoHinh.CauHinhTinTuc
@{
    ViewData["Title"] = "Bản tin";

    var fontHeading = string.IsNullOrEmpty(Model?.FontTieuDe) ? "Dancing Script" : Model.FontTieuDe;
    var fontBody = string.IsNullOrEmpty(Model?.FontNoiDung) ? "Be Vietnam Pro" : Model.FontNoiDung;
    var posts = Model?.BaiViets?.OrderBy(b => b.ThuTu).ToList() ?? new List<WEB_TinhNguyen.MoHinh.BaiVietTinTuc>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=@(fontHeading.Replace(" ", "+")):wght@600;700;800&family=@(fontBody.Replace(" ", "+")):wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .tintuc-wrapper {
        font-family: '@Html.Raw(fontBody)', sans-serif;
    }

    .tintuc-display {
        font-family: '@Html.Raw(fontHeading)', cursive, sans-serif;
    }

    /* Thanh cuộn mượt mà trong Popup */
    .news-modal-scroll::-webkit-scrollbar {
        width: 7px;
    }

    .news-modal-scroll::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 10px;
    }

    .news-modal-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }

        .news-modal-scroll::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

    /* Định dạng văn bản và toàn bộ hình ảnh bên trong Popup */
    .news-modal-body p {
        margin-bottom: 0.9rem;
        line-height: 1.75;
    }

    .news-modal-body figure {
        margin: 1.25rem 0;
        width: 100%;
    }

    .news-modal-body img,
    .popup-full-image {
        display: block;
        width: 100%;
        height: auto;
        max-height: none;
        object-fit: contain;
        border-radius: 1rem;
        margin-top: 1.25rem;
        margin-bottom: 0.5rem;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .animate-modalPop {
        animation: modalPop 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes modalPop {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(8px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
</style>

<main class="tintuc-wrapper">
    <!-- ========================================================================= -->
    <!-- SECTION 1: HERO BANNER                                                    -->
    <!-- ========================================================================= -->
    <section class="relative flex items-center overflow-hidden px-6 text-center min-h-[75svh] sm:min-h-[85svh] py-24 sm:py-32 bg-gradient-to-b from-emerald-50/70 via-white to-volunteer-50/40 dark:from-volunteer-night dark:via-volunteer-card dark:to-volunteer-night transition-colors duration-300">
        <div class="relative z-10 mx-auto w-full max-w-3xl animate-fade-in-up">
            <span class="mb-4 inline-block rounded-full px-5 py-2 text-xs font-black uppercase tracking-[0.2em] bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 shadow-xs">
                @(Model?.Hero_Nhan ?? "Bản tin")
            </span>
            <h1 class="tintuc-display pb-3 font-bold leading-[1.18] sm:pb-5 text-volunteer-text dark:text-white"
                style="font-size: @(Model?.Hero_CoChuTieuDe ?? "64px");">
                @(Model?.Hero_TieuDe ?? "Câu chuyện từ hành trình")
            </h1>
            <p class="mx-auto mt-5 max-w-xl text-base sm:text-lg leading-relaxed text-volunteer-text/80 dark:text-slate-300 font-medium">
                @(Model?.Hero_MoTa ?? "Những dòng nhật ký, hình ảnh và tin tức mới nhất về Trăng Sáng Langbiang. Đăng ký bản tin để không bỏ lỡ mùa 2026!")
            </p>
        </div>
    </section>

    <!-- ========================================================================= -->
    <!-- SECTION 2: DANH SÁCH BÀI VIẾT BẢN TIN                                     -->
    <!-- ========================================================================= -->
    <section id="news" class="relative py-16 sm:py-24 bg-white dark:bg-volunteer-night transition-colors duration-300">

        <!-- SVG Trang trí tĩnh 1 -->
        <svg viewBox="0 0 320 220" class="pointer-events-none absolute -left-6 -top-6 z-10 h-56 w-72 animate-sway opacity-90 md:h-72 md:w-96" aria-hidden="true">
            <g fill="none" stroke="#2e7d32" stroke-width="3" stroke-linecap="round">
                <path d="M10 10 C 80 40, 150 30, 240 80" opacity="0.6"></path>
                <path d="M10 10 C 60 70, 120 90, 200 150" opacity="0.5"></path>
            </g>
            <ellipse cx="40" cy="22" rx="20" ry="9" fill="#5cb85c" transform="rotate(25 40 22)" opacity="0.95"></ellipse>
            <ellipse cx="78" cy="40" rx="22" ry="10" fill="#7cc34a" transform="rotate(35 78 40)" opacity="0.9"></ellipse>
            <ellipse cx="120" cy="34" rx="18" ry="8" fill="#4caf50" transform="rotate(20 120 34)" opacity="0.95"></ellipse>
            <ellipse cx="165" cy="58" rx="24" ry="11" fill="#5cb85c" transform="rotate(40 165 58)" opacity="0.9"></ellipse>
            <ellipse cx="210" cy="82" rx="20" ry="9" fill="#7cc34a" transform="rotate(30 210 82)" opacity="0.92"></ellipse>
            <ellipse cx="60" cy="78" rx="18" ry="8" fill="#4caf50" transform="rotate(55 60 78)" opacity="0.85"></ellipse>
            <ellipse cx="110" cy="100" rx="22" ry="10" fill="#5cb85c" transform="rotate(60 110 100)" opacity="0.9"></ellipse>
            <ellipse cx="160" cy="128" rx="20" ry="9" fill="#7cc34a" transform="rotate(65 160 128)" opacity="0.88"></ellipse>
            <ellipse cx="200" cy="150" rx="17" ry="8" fill="#4caf50" transform="rotate(70 200 150)" opacity="0.85"></ellipse>
        </svg>

        <!-- SVG Trang trí tĩnh 2 -->
        <svg width="34" height="34" viewBox="0 0 40 40" class="pointer-events-none absolute right-6 top-1/3 z-10 h-16 w-16 animate-float opacity-70 md:h-24 md:w-24" aria-hidden="true">
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(0 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(45 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(90 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(135 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(180 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(225 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(270 20 20)"></ellipse>
            <ellipse cx="20" cy="8" rx="4.2" ry="9" fill="#ffffff" transform="rotate(315 20 20)"></ellipse>
            <circle cx="20" cy="20" r="5.5" fill="#f5a623"></circle>
        </svg>

        <div class="relative z-20 mx-auto max-w-7xl px-5 sm:px-6">
            <div class="mt-6 grid gap-6 sm:mt-10 md:grid-cols-3">
                @for (int i = 0; i < posts.Count; i++)
                {
                    var news = posts[i];
                    // Đảm bảo luôn có ảnh để hiển thị ở cuối Popup:
                    // Nếu có LinkAnhTrongBai thì ưu tiên dùng, nếu không có thì tự động lấy LinkAnhDaiDien
                    var popupImages = !string.IsNullOrWhiteSpace(news.LinkAnhTrongBai)
                        ? news.LinkAnhTrongBai
                        : news.LinkAnhDaiDien;

                    <article class="group relative flex h-full flex-col overflow-hidden rounded-3xl bg-white/85 ring-1 ring-leaf/10 shadow-sm transition duration-300 hover:-translate-y-1.5 hover:shadow-xl cursor-pointer"
                             onclick="openNewsModal(@i)">

                        <!-- Khung Ảnh 16:10 + Tag -->
                        <div class="relative aspect-[16/10] w-full overflow-hidden bg-black/5">
                            <img alt="@news.TieuDe" src="@news.LinkAnhDaiDien" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
                            @if (!string.IsNullOrEmpty(news.ThePhanLoai))
                            {
                                <span class="absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-bold backdrop-blur-sm shadow-sm"
                                      style="background-color: #2e7d32; color: #ffffff;">
                                    @news.ThePhanLoai
                                </span>
                            }
                        </div>

                        <!-- Nội dung Card -->
                        <div class="flex flex-1 flex-col p-5 sm:p-6">
                            <h3 class="mt-1 font-bold leading-snug"
                                style="color: #1b5e20; font-size: @(news.CoChuTieuDe ?? "18px");">
                                @news.TieuDe
                            </h3>
                            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-gray-700 line-clamp-4">
                                @news.TrichDan
                            </p>

                            <!-- Chân Card: Nút Đọc tiếp & Nút Thả tim -->
                            <div class="mt-5 pt-3 border-t border-gray-100 flex items-center justify-between">
                                <span class="inline-flex items-center gap-1.5 text-sm font-semibold transition group-hover:gap-2.5"
                                      style="color: #2e7d32;">
                                    Đọc tiếp
                                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                                </span>

                                <!-- Nút Thả tim -->
                                <div class="relative z-20" onclick="event.stopPropagation();">
                                    <button type="button" onclick="likePost(@news.IDBaiViet, this)"
                                            aria-label="Thích bài viết"
                                            class="inline-flex items-center gap-1.5 text-xs font-semibold transition-all hover:scale-110 text-gray-700 hover:text-rose-500">
                                        <svg viewBox="0 0 24 24" class="h-4 w-4 transition-transform fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path>
                                        </svg>
                                        <span class="tabular-nums font-bold like-count">@news.LuotThich</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Lưu trữ dữ liệu ẩn của bài viết để hiển thị trong Popup -->
                        <div id="post-data-@i" class="hidden"
                             data-title="@news.TieuDe"
                             data-title-color="#38bdf8"
                             data-cover-img="@news.LinkAnhDaiDien"
                             data-bottom-img="@popupImages"
                             data-fb-link="@news.LinkBaiVietGoc">
                            @Html.Raw(string.IsNullOrWhiteSpace(news.NoiDungChiTiet) ? $"<p>{news.TrichDan}</p>" : news.NoiDungChiTiet)
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
</main>

<!-- ========================================================================= -->
<!-- POPUP ĐỌC CHI TIẾT BÀI VIẾT (HIỂN THỊ NỘI DUNG + TOÀN BỘ ẢNH BÊN DƯỚI)    -->
<!-- ========================================================================= -->
<div id="newsReaderModal"
     class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4 sm:p-6 transition-opacity"
     onclick="closeNewsModal()">

    <div class="bg-white rounded-[28px] max-w-3xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden border border-gray-100 animate-modalPop"
         onclick="event.stopPropagation();">

        <!-- Header cố định: Tiêu đề bên trái + Nút X tròn bên phải -->
        <div class="flex items-start justify-between gap-4 px-6 sm:px-8 pt-6 pb-4 border-b border-gray-100 bg-white sticky top-0 z-10">
            <h2 id="modalPostTitle" class="text-lg sm:text-xl font-extrabold leading-snug uppercase tracking-tight"></h2>
            <button type="button" onclick="closeNewsModal()"
                    class="h-9 w-9 shrink-0 rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 hover:text-gray-800 flex items-center justify-center transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Body có thanh cuộn dọc: Nội dung văn bản ở trên + Toàn bộ Ảnh đầy đủ bên dưới -->
        <div class="px-6 sm:px-8 py-5 overflow-y-auto news-modal-scroll flex-1">
            <!-- 1. Nội dung văn bản chi tiết -->
            <div id="modalPostBody" class="news-modal-body text-gray-800 text-sm sm:text-[15.5px] leading-relaxed"></div>

            <!-- 2. Khung hiển thị TOÀN BỘ ẢNH bên dưới nội dung -->
            <div id="modalPostImagesContainer" class="mt-6 space-y-5"></div>

            <!-- 3. Nút xem bài gốc trên Fanpage (nếu có) -->
            <div id="modalPostFbWrapper" class="mt-6 pt-4 border-t border-gray-100 text-right hidden">
                <a id="modalPostFbLink" href="#" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-emerald-700 hover:text-emerald-800 hover:underline">
                    Xem bài đăng gốc trên Fanpage ↗
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function openNewsModal(index) {
        const dataEl = document.getElementById('post-data-' + index);
        if (!dataEl) return;

        const title = dataEl.getAttribute('data-title');
        const titleColor = dataEl.getAttribute('data-title-color') || '#38bdf8';
        const coverImg = dataEl.getAttribute('data-cover-img') || '';
        const bottomImgRaw = dataEl.getAttribute('data-bottom-img') || '';
        const fbLink = dataEl.getAttribute('data-fb-link');
        const bodyHtml = dataEl.innerHTML;

        // 1. Gán tiêu đề và màu sắc
        const titleEl = document.getElementById('modalPostTitle');
        titleEl.innerText = title;
        titleEl.style.color = titleColor;

        // 2. Gán nội dung bài viết
        const bodyContainer = document.getElementById('modalPostBody');
        bodyContainer.innerHTML = bodyHtml;

        // 3. Hiển thị TOÀN BỘ ẢNH bên dưới nội dung
        const imagesContainer = document.getElementById('modalPostImagesContainer');
        imagesContainer.innerHTML = '';

        // Tách danh sách ảnh (hỗ trợ nhiều ảnh ngăn cách bằng dấu | hoặc , hoặc xuống dòng)
        let imgList = [];
        if (bottomImgRaw.trim() !== '') {
            imgList = bottomImgRaw.split(/[|\n,]+/).map(s => s.trim()).filter(s => s !== '');
        }
        // Nếu vẫn chưa có ảnh nào thì dùng chính Ảnh bìa của bài viết đó
        if (imgList.length === 0 && coverImg.trim() !== '') {
            imgList.push(coverImg.trim());
        }

        // Kiểm tra xem ảnh đã có sẵn trong thẻ <img> của bodyHtml chưa để tránh bị lặp 2 lần
        imgList.forEach(imgUrl => {
            if (!bodyHtml.includes(imgUrl)) {
                const imgTag = document.createElement('img');
                imgTag.src = imgUrl;
                imgTag.alt = title;
                imgTag.className = 'popup-full-image';
                imagesContainer.appendChild(imgTag);
            }
        });

        // 4. Xử lý link bài gốc
        const fbWrapper = document.getElementById('modalPostFbWrapper');
        const fbEl = document.getElementById('modalPostFbLink');
        if (fbLink && fbLink.trim() !== '' && fbLink !== '/') {
            fbEl.href = fbLink;
            fbWrapper.classList.remove('hidden');
        } else {
            fbWrapper.classList.add('hidden');
        }

        // Mở Modal và cuộn lên đầu
        const modal = document.getElementById('newsReaderModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        modal.querySelector('.news-modal-scroll').scrollTop = 0;
        document.body.style.overflow = 'hidden';
    }

    function closeNewsModal() {
        const modal = document.getElementById('newsReaderModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
    }

    // Đóng Popup khi nhấn phím ESC
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeNewsModal();
    });

    // Hàm gọi API Thả tim bài viết
    function likePost(id, btn) {
        if (!id || btn.dataset.liked === 'true') return;
        btn.dataset.liked = 'true';
        btn.classList.add('text-rose-500');
        const svg = btn.querySelector('svg');
        if (svg) svg.setAttribute('fill', 'currentColor');

        const countSpan = btn.querySelector('.like-count');
        const currentLikes = parseInt(countSpan.innerText) || 0;
        countSpan.innerText = currentLikes + 1;

        fetch('/Home/LikeBaiViet?id=' + id, { method: 'POST' }).catch(err => console.warn(err));
    }
</script>