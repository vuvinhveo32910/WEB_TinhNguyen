<main>
    <!-- HERO SECTION -->
    <section class="relative flex items-center overflow-hidden px-6 text-center py-16 sm:py-20">
        <div class="absolute inset-0 -z-20 bg-gradient-to-b from-sky-soft via-[#dff2e6] to-cream dark:from-[#0a1626] dark:via-night-2 dark:to-night"></div>
        <div class="relative z-10 mx-auto w-full max-w-3xl">
            <span class="mb-3 inline-block rounded-full bg-white/50 px-5 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-leaf-deep backdrop-blur dark:bg-white/5 dark:text-leaf-bright">Lời chúc</span>
            <h1 class="font-display pb-3 font-bold leading-[1.18] text-gradient-green sm:pb-5 text-3xl sm:text-5xl">Gửi yêu thương từ trái tim</h1>
            <p class="mx-auto mt-5 max-w-xl text-base sm:text-lg text-forest/80 dark:text-ink/80">Những lời chúc ấm áp từ các tình nguyện viên Trăng Sáng Langbiang mùa 2026.</p>
        </div>
    </section>

    <!-- CALL TO ACTION (SEND WISH) -->
    <section class="mx-auto max-w-6xl px-5 pb-10 sm:px-6">
        <div class="flex flex-col items-center gap-4 rounded-3xl border border-leaf/15 bg-white/60 px-6 py-8 text-center backdrop-blur-sm dark:border-leaf-bright/15 dark:bg-white/5 sm:flex-row sm:justify-between sm:text-left">
            <div>
                <h2 class="font-display text-2xl font-bold text-forest dark:text-ink sm:text-3xl">Bạn muốn gửi lời chúc?</h2>
                <p class="mt-1 text-sm text-forest/70 dark:text-ink/70">Đã có 43 lời chúc được gửi tới Langbiang.</p>
            </div>
            <button type="button" class="inline-flex min-h-12 shrink-0 cursor-pointer items-center gap-2 px-7 py-3.5 rounded-full bg-gradient-to-r from-leaf-deep to-leaf text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:brightness-110 focus-visible:ring-2 focus-visible:ring-leaf focus-visible:ring-offset-2 sm:text-base dark:focus-visible:ring-offset-night">
                <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                Gửi lời chúc
            </button>
        </div>
    </section>

    <!-- MASONRY GRID LỜI CHÚC -->
    <section class="mx-auto px-5 pb-16 sm:px-6 sm:pb-24 max-w-6xl">
        <!-- Tìm kiếm -->
        <div class="mb-8 flex justify-center ">
            <div class="relative w-full max-w-md">
                <svg viewBox="0 0 24 24" class="absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-forest/40 dark:text-ink/40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg>
                <input type="text" placeholder="Tìm theo tên TNV…" class="w-full rounded-full border-0 bg-white/70 py-3 pl-11 pr-4 text-sm text-forest ring-1 ring-leaf/15 transition placeholder:text-forest/40 focus:ring-2 focus:ring-leaf/30 dark:bg-white/5 dark:text-ink dark:ring-leaf-bright/15 dark:placeholder:text-ink/40 dark:focus:ring-leaf-bright/30" value="">
            </div>
        </div>

        <!-- Render List bằng Vòng lặp -->
        <div class="columns-1 gap-4 sm:columns-2 md:columns-3 lg:columns-4 [&>*]:mb-4 [&>*]:break-inside-avoid ">
            @foreach (var wish in wishesData)
            {
                <a class="block cursor-pointer" href="/loi-chuc/@wish.Id">
                    <div class="@("@container") relative w-full overflow-hidden rounded-2xl @("@sm:rounded-[1.5rem]") border border-leaf/25 bg-gradient-to-b from-[#ffffff] via-[#fcfbf7] to-[#f2f9ee] shadow-sm hover:shadow-md transition-shadow">
                        <!-- SVG Hình khối trang trí (Trái) -->
                        <svg viewBox="0 0 70 40" class="pointer-events-none absolute opacity-70 -left-1 top-1.5 h-5 w-9 @("@sm:top-2") @("@sm:h-7") @("@sm:w-12") @("@lg:h-8") @("@lg:w-14")" aria-hidden="true"><path d="M10 28 Q5 28 5 22 Q5 16 12 15 Q15 6 26 8 Q32 3 40 6 Q48 2 54 9 Q62 10 62 18 Q66 22 62 28 Z" fill="#8fd8f7" opacity="0.75"></path></svg>
                        <svg viewBox="0 0 70 40" class="pointer-events-none absolute opacity-50 right-10 top-3 h-4 w-7 @("@sm:right-12") @("@sm:top-5") @("@sm:h-5") @("@sm:w-9") @("@lg:h-6") @("@lg:w-10")" aria-hidden="true"><path d="M10 28 Q5 28 5 22 Q5 16 12 15 Q15 6 26 8 Q32 3 40 6 Q48 2 54 9 Q62 10 62 18 Q66 22 62 28 Z" fill="#8fd8f7" opacity="0.75"></path></svg>

                        <!-- SVG Hình khối trang trí (Phải - Trăng sao) -->
                        <svg viewBox="0 0 60 60" class="pointer-events-none absolute right-3 top-2.5 h-7 w-7 @("@2xs:h-8") @("@2xs:w-8") @("@sm:h-9") @("@sm:w-9") @("@lg:h-10") @("@lg:w-10") @("@2xl:h-11") @("@2xl:w-11")" aria-hidden="true"><circle cx="30" cy="30" r="16" fill="#f5a623" opacity="0.9"></circle><circle cx="30" cy="30" r="13" fill="#ffe066"></circle><circle cx="25" cy="28" r="1.5" fill="#a05a00"></circle><circle cx="35" cy="28" r="1.5" fill="#a05a00"></circle><path d="M26 34 Q30 38 34 34" stroke="#a05a00" stroke-width="1.5" stroke-linecap="round" fill="none"></path><circle cx="23" cy="32" r="2" fill="#ff7a7a" opacity="0.6"></circle><circle cx="37" cy="32" r="2" fill="#ff7a7a" opacity="0.6"></circle><g stroke="#f5a623" stroke-width="2" stroke-linecap="round"><line x1="30" y1="6" x2="30" y2="10"></line><line x1="30" y1="50" x2="30" y2="54"></line><line x1="6" y1="30" x2="10" y2="30"></line><line x1="50" y1="30" x2="54" y2="30"></line><line x1="13" y1="13" x2="16" y2="16"></line><line x1="44" y1="44" x2="47" y2="47"></line><line x1="13" y1="47" x2="16" y2="44"></line><line x1="44" y1="16" x2="47" y2="13"></line></g></svg>

                        <div class="relative z-10 flex flex-col items-center text-center px-3.5 pb-11 pt-4 @("@2xs:px-4") @("@2xs:pb-12") @("@2xs:pt-5") @("@sm:px-5") @("@sm:pb-14") @("@sm:pt-6") @("@lg:px-8") @("@lg:pb-18") @("@lg:pt-7") @("@2xl:px-10") @("@2xl:pb-20") @("@2xl:pt-9")">

                            <!-- Khung ảnh đại diện -->
                            <div class="relative mb-2.5 mt-0.5">
                                <div class="pointer-events-none absolute z-20 h-4 w-12 -rotate-6 rounded-xs bg-amber-200/90 shadow-xs ring-1 ring-amber-400/30 backdrop-blur-xs -top-2 left-1/2 -translate-x-1/2" style="clip-path:polygon(0% 15%, 5% 0%, 95% 0%, 100% 15%, 98% 85%, 100% 100%, 0% 100%, 2% 85%)"></div>
                                <div class="relative overflow-hidden rounded-xl border-[3.5px] @("@sm:border-[4px]") border-white bg-white shadow-sm -rotate-1 h-28 w-28 @("@2xs:h-32") @("@2xs:w-32") @("@sm:h-40") @("@sm:w-40") @("@lg:h-52") @("@lg:w-52") @("@2xl:h-64") @("@2xl:w-64")">
                                    <img alt="@wish.AuthorName" src="@wish.ImageUrl" class="absolute inset-0 object-cover h-full w-full" />
                                </div>
                            </div>

                            <!-- Nội dung lời chúc -->
                            <div class="mt-0.5 w-full max-w-md @("@2xl:max-w-xl") px-1">
                                <p class="font-display font-bold leading-snug text-forest break-words text-sm @("@2xs:text-lg") @("@sm:text-xl") @("@lg:text-2xl") @("@2xl:text-3xl")">“@wish.Message”</p>
                                <p class="mt-1 font-display font-bold text-sunset break-words text-xs @("@2xs:text-sm") @("@sm:text-lg") @("@lg:text-2xl") @("@2xl:text-3xl")">— @wish.AuthorName —</p>

                                @if (!string.IsNullOrEmpty(wish.Role))
                                {
                                    <p class="mt-3.5 @("@sm:mt-4") font-sans text-forest/70 text-[11px] @("@2xs:text-xs") @("@sm:text-sm") @("@lg:text-base") @("@2xl:text-lg")">@wish.Role</p>
                                }
                            </div>
                        </div>

                        <!-- SVG Lượn sóng trang trí (Dưới cùng card) -->
                        <svg viewBox="0 0 420 100" preserveAspectRatio="none" class="pointer-events-none absolute inset-x-0 bottom-0 w-full h-10 @("@2xs:h-11") @("@sm:h-12") @("@lg:h-14") @("@2xl:h-16")" aria-hidden="true"><path d="M0 100 L0 55 Q40 25 80 50 Q130 15 190 45 Q240 10 300 40 Q360 20 420 50 L420 100 Z" fill="#b8e6b8" opacity="0.5"></path><path d="M0 100 L0 70 Q50 45 100 65 Q150 35 220 60 Q280 40 350 65 Q390 50 420 68 L420 100 Z" fill="#7cc34a" opacity="0.35"></path><path d="M0 100 L0 80 Q60 65 130 78 Q200 62 270 76 Q340 65 420 78 L420 100 Z" fill="#5cb85c" opacity="0.25"></path><g transform="translate(18, 25)"><polygon points="12,5 4,22 20,22" fill="#2e7d32"></polygon><polygon points="12,14 2,34 22,34" fill="#388e3c"></polygon><polygon points="12,25 0,48 24,48" fill="#2e7d32"></polygon><rect x="10" y="48" width="4" height="8" fill="#795548"></rect></g><g transform="translate(370, 30)"><polygon points="10,5 3,20 17,20" fill="#388e3c"></polygon><polygon points="10,13 1,30 19,30" fill="#2e7d32"></polygon><polygon points="10,22 0,42 20,42" fill="#43a047"></polygon><rect x="8" y="42" width="4" height="7" fill="#795548"></rect></g><g transform="translate(80, 68)"><circle cx="6" cy="6" r="3" fill="#f5a623"></circle><circle cx="6" cy="1" r="2" fill="#ffffff"></circle><circle cx="11" cy="6" r="2" fill="#ffffff"></circle><circle cx="6" cy="11" r="2" fill="#ffffff"></circle><circle cx="1" cy="6" r="2" fill="#ffffff"></circle></g><g transform="translate(310, 66)"><circle cx="6" cy="6" r="3" fill="#f5a623"></circle><circle cx="6" cy="1" r="2" fill="#ffffff"></circle><circle cx="11" cy="6" r="2" fill="#ffffff"></circle><circle cx="6" cy="11" r="2" fill="#ffffff"></circle><circle cx="1" cy="6" r="2" fill="#ffffff"></circle></g><g transform="translate(195, 62)"><circle cx="5" cy="5" r="2.5" fill="#f5a623"></circle><circle cx="5" cy="1" r="1.5" fill="#ffffff"></circle><circle cx="9" cy="5" r="1.5" fill="#ffffff"></circle><circle cx="5" cy="9" r="1.5" fill="#ffffff"></circle><circle cx="1" cy="5" r="1.5" fill="#ffffff"></circle></g><g transform="translate(140, 32)"><ellipse cx="4" cy="4" rx="3" ry="2" fill="#ff7a7a" transform="rotate(-30 4 4)"></ellipse><ellipse cx="9" cy="4" rx="3" ry="2" fill="#ff7a7a" transform="rotate(30 9 4)"></ellipse><line x1="6.5" y1="2" x2="6.5" y2="7" stroke="#6d4c41" stroke-width="0.8"></line></g></svg>
                    </div>
                </a>
            }
        </div>
        <div class="flex justify-center py-8"></div>
    </section>

    <!-- FLOATING BUTTON -->
    <button type="button" aria-hidden="true" tabindex="-1" class="fixed bottom-[max(1.25rem,env(safe-area-inset-bottom))] right-5 z-40 inline-flex min-h-14 cursor-pointer items-center gap-2 px-6 py-4 rounded-full bg-gradient-to-r from-leaf-deep to-leaf text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:brightness-110 shadow-xl focus-visible:ring-2 focus-visible:ring-leaf focus-visible:ring-offset-2">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
        <span class="hidden sm:inline">Gửi lời chúc</span>
        <span class="sr-only sm:hidden">Gửi lời chúc</span>
    </button>
</main>