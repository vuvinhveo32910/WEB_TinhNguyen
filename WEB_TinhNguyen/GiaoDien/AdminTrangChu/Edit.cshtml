@model WEB_TinhNguyen.MoHinh.CauHinhTrangChuVM
@{
    ViewData["Title"] = "Cấu hình Landing Page";
    Layout = "~/GiaoDien/Shared/_AdminLayout.cshtml";
}

<!-- HEADER -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
            <a href="@Url.Action("Index", "AdminTrangChu")" class="hover:text-[#1b5e20] font-medium transition">
                <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
            </a>
            <span>/</span>
            <span class="font-semibold text-gray-600">Chiến dịch @Model.TenChienDich</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
            Cấu hình Trang chủ - <span class="text-[#2e7d32]">@Model.TenChienDich</span>
        </h2>
    </div>
    <div class="flex items-center gap-3">
        <a href="/" target="_blank" class="inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-semibold rounded-lg text-gray-700 bg-white hover:bg-gray-50 shadow-sm transition">
            <i class="fas fa-external-link-alt mr-2 text-gray-400"></i> Xem trang ngoài
        </a>
        <button type="submit" form="configForm" class="inline-flex items-center px-6 py-2 text-sm font-bold rounded-lg text-white bg-[#1b5e20] hover:bg-green-800 shadow-md transition">
            <i class="fas fa-save mr-2"></i> Lưu Cấu Hình Toàn Trang
        </button>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="bg-green-50 text-green-700 p-4 rounded-xl mb-6 shadow-sm border border-green-200 flex items-start gap-3">
        <i class="fas fa-check-circle mt-0.5"></i>
        <div class="font-semibold">@TempData["Success"]</div>
    </div>
}

@if (!ViewData.ModelState.IsValid || TempData["Error"] != null)
{
    <div class="bg-red-50 text-red-600 p-4 rounded-xl mb-6 shadow-sm border border-red-200 flex items-start gap-3">
        <i class="fas fa-exclamation-circle mt-0.5"></i>
        <div>
            @if (TempData["Error"] != null)
            {
                <p>@TempData["Error"]</p>
            }
            @Html.ValidationSummary(false)
        </div>
    </div>
}

<form asp-action="Edit" method="post" enctype="multipart/form-data" id="configForm" class="pb-20">
    <input type="hidden" asp-for="IDCauHinh" />
    <input type="hidden" asp-for="IDChienDich" />

    <!-- TABS NAV -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-3 pt-3 mb-6">
        <div class="flex space-x-2 overflow-x-auto pb-2 sidebar-scroll">
            <button type="button" class="tab-btn active shrink-0 px-4 py-2.5 text-sm font-bold rounded-lg text-[#2e7d32] bg-green-50 transition" data-target="tab1">🎨 Giao diện Toàn Web</button>
            <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:bg-gray-50 transition" data-target="tabBanner">🖼️ Banner Ảnh Chạy</button>
            <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:bg-gray-50 transition" data-target="tabEvents">⏱️ Đếm Ngược</button>
            <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:bg-gray-50 transition" data-target="tab2">📖 Về Dự Án</button>
            <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:bg-gray-50 transition" data-target="tab3">✨ Ảnh Nổi Parallax</button>
            <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:bg-gray-50 transition" data-target="tab4">📺 Tivi Khoảnh Khắc</button>
            <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:bg-gray-50 transition" data-target="tab5">📰 Bản Tin</button>
            <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-lg text-gray-500 hover:bg-gray-50 transition" data-target="tab6">🤝 Tài Trợ & FAQ</button>
        </div>
    </div>

    <!-- TAB 1: GIAO DIỆN CHUNG TOÀN WEB -->
    <div id="tab1" class="tab-content block space-y-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3 mb-5"><i class="fas fa-paint-brush mr-2 text-[#2e7d32]"></i> Thông tin & Giao diện toàn Web</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <div class="col-span-1 md:col-span-2 bg-gray-50 p-5 rounded-xl border border-gray-200 flex items-center gap-6">
                    @if (!string.IsNullOrEmpty(Model.LinkAnhBiaCu))
                    {
                        <div class="bg-white p-3 rounded-xl shadow-sm border border-gray-200 shrink-0">
                            <img src="@Model.LinkAnhBiaCu" class="h-20 w-auto object-contain" />
                        </div>
                    }
                    <div class="flex-1">
                        <label class="block font-bold text-gray-700 mb-2">Logo Thương Hiệu (Góc trái trên)</label>
                        <input type="hidden" asp-for="LinkAnhBiaCu" />
                        <input type="file" name="FileAnhBia" accept="image/*" class="w-full text-sm border p-2 bg-white rounded-lg" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Tên Web (Dòng chữ nhỏ ở trên)</label>
                    <input type="text" asp-for="TieuDePhu" placeholder="VD: DỰ ÁN TÌNH NGUYỆN" class="w-full border border-gray-300 rounded-lg p-2.5 focus:border-[#2e7d32] outline-none transition" />
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Tên Web (Dòng chữ to ở dưới)</label>
                    <input type="text" asp-for="TieuDeChinh" placeholder="VD: Trăng sáng Langbiang" class="w-full border border-gray-300 rounded-lg p-2.5 focus:border-[#2e7d32] outline-none transition" />
                </div>


                <div class="col-span-1 md:col-span-2">
                    <label class="block text-sm font-bold text-gray-700 mb-1">Font chữ Tên Web (Google Fonts)</label>
                    <input type="text" asp-for="FontTieuDe" placeholder="VD: Dancing Script" class="w-full border border-gray-300 rounded-lg p-2.5 focus:border-[#2e7d32] outline-none transition" />
                    <p class="text-xs text-gray-500 mt-1"><i class="fas fa-info-circle mr-1"></i> Sử dụng tên Font lấy từ Google Fonts (nhập chính xác tên, VD: Be Vietnam Pro).</p>
                </div>

                <!-- ĐÂY LÀ ĐOẠN ĐÃ THÊM NÚT TẢI LÊN HIỆU ỨNG NHANH -->
                <div class="col-span-1 md:col-span-2 bg-gradient-to-r from-green-50 to-emerald-50 p-5 rounded-xl border border-green-200 mt-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h4 class="font-bold text-green-800 text-lg mb-1"><i class="fas fa-magic mr-1"></i> Hiệu ứng Toàn trang</h4>
                        <p class="text-xs text-green-700">Chọn hoặc tải lên hiệu ứng rơi động cho trang chủ (Hoa mai, tuyết rơi...)</p>
                    </div>
                    <div class="flex items-center gap-3 w-full md:w-1/2">
                        <select asp-for="IDHieuUng" class="flex-1 border border-green-300 rounded-lg p-2.5 font-bold text-green-900 bg-white focus:ring-green-500 outline-none">
                            <option value="">-- Không dùng hiệu ứng --</option>
                            @if (ViewBag.DanhSachHieuUng != null)
                            {
                                foreach (var hieuUng in ViewBag.DanhSachHieuUng)
                                {
                                    <option value="@hieuUng.IDHieuUng">✨ @hieuUng.TenHieuUng</option>
                                }
                            }
                        </select>
                        <button type="button" onclick="openUploadEffectModal()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2.5 rounded-lg shadow-sm font-bold transition whitespace-nowrap">
                            <i class="fas fa-upload mr-1"></i> Tải lên
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- CẤU HÌNH LINH VẬT FOOTER -->
    <div class="col-span-1 md:col-span-2 bg-indigo-50/50 p-6 rounded-xl border border-indigo-100 mt-2">
        <div class="flex items-center justify-between mb-4">
            <h4 class="font-bold text-indigo-900 text-lg"><i class="fas fa-cat mr-2 text-indigo-500"></i>Linh vật trang trí (Góc dưới Footer)</h4>
            <label class="font-bold text-indigo-700 cursor-pointer flex items-center gap-2 bg-white px-3 py-1.5 rounded-lg shadow-sm border border-indigo-100">
                <input type="checkbox" asp-for="HienThiMascot" class="w-4 h-4 accent-indigo-600 rounded" /> Hiển thị Linh vật
            </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100">
                <label class="block text-sm font-bold text-gray-700 mb-2">Hình ảnh (Nên dùng ảnh đuôi .PNG nền trong suốt)</label>
                <input type="hidden" asp-for="LinkAnhMascotCu" />
                @if (!string.IsNullOrEmpty(Model.LinkAnhMascotCu))
                {
                    <div class="bg-gray-100 rounded-lg p-2 mb-3 inline-block">
                        <img src="@Model.LinkAnhMascotCu" class="h-20 w-auto object-contain drop-shadow-md" />
                    </div>
                }
                <input type="file" name="FileAnhMascot" accept="image/*" class="w-full text-sm file-upload border border-gray-200 p-1.5 rounded-lg" />
            </div>

            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex flex-col justify-center">
                <label class="block text-sm font-bold text-gray-700 mb-2">Vị trí đứng của Linh vật</label>
                <select asp-for="ViTriMascot" class="w-full border border-gray-300 rounded-lg p-3 text-sm font-bold text-indigo-900 outline-none focus:border-indigo-500">
                    <option value="right">Nằm ở Góc Phải</option>
                    <option value="left">Nằm ở Góc Trái</option>
                    <option value="center">Nằm ở Chính Giữa</option>
                </select>
            </div>
        </div>
    </div>
    <!-- CÁC TAB KHÁC (BANNER, EVENT, DỰ ÁN...) NẰM Ở ĐÂY, GIỮ NGUYÊN CODE CỦA BẠN NHÉ ĐỂ CHO ĐỠ DÀI -->
    <!-- (Bạn cứ dán y nguyên những tab bạn đang có ở file hiện tại vào đây, bắt đầu từ <div id="tabBanner"... đến hết <div id="tab6"... ) -->
    <!-- CHỖ NÀY TÔI RÚT GỌN ĐỂ CHỈ HIỂN THỊ PHẦN QUAN TRỌNG NHẤT CHO BẠN DỄ NHÌN, BẠN NHỚ COPY CHÈN TỪ TAB BANNER ĐẾN TAB 6 CỦA BẠN VÀO NHÉ -->
    <!-- TAB BANNER -->
    <div id="tabBanner" class="tab-content hidden space-y-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
            <div class="flex flex-col sm:flex-row justify-between sm:items-center border-b border-gray-100 pb-4 mb-6">
                <h3 class="text-lg font-bold text-gray-900"><i class="fas fa-images mr-2 text-[#2e7d32]"></i> Banner Ảnh Chạy</h3>
                <div class="flex items-center gap-3 mt-3 sm:mt-0 bg-gray-50 p-2 rounded-lg border border-gray-200">
                    <label class="text-sm font-bold text-gray-700">Tốc độ chạy ảnh ngang (ms):</label>
                    <input type="number" asp-for="TocDoChuyenSlide" class="w-24 border border-gray-300 rounded-lg p-1.5 text-center font-bold outline-none focus:border-[#2e7d32]" />
                </div>
            </div>

            <button type="button" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2.5 rounded-lg shadow-sm font-bold transition flex items-center gap-2" onclick="addRepeaterItem('repeaterBanner', 'templateBanner')">
                <i class="fas fa-plus"></i> Thêm Ảnh Banner
            </button>

            <div id="repeaterBanner" class="space-y-4 mt-6 grid grid-cols-1 md:grid-cols-2 gap-5">
                @for (int i = 0; i < Model.Banners.Count; i++)
                {
                    <div class="bg-gray-50 border border-gray-200 p-5 rounded-xl relative r-item shadow-sm col-span-1 mt-0">
                        <button type="button" class="absolute top-3 right-3 bg-white text-red-500 hover:bg-red-50 hover:text-red-600 border border-red-100 px-3 py-1 rounded-lg text-xs font-bold transition shadow-sm btn-remove"><i class="fas fa-trash-alt mr-1"></i> Xóa</button>
                        <input type="hidden" asp-for="Banners[i].LinkAnhCu" />

                        <label class="font-bold text-gray-700 text-sm block mb-2">Upload Banner (Tối đa 2MB)</label>
                        @if (!string.IsNullOrEmpty(Model.Banners[i].LinkAnhCu))
                        {
                            <img src="@Model.Banners[i].LinkAnhCu" class="h-32 object-cover w-full my-3 rounded-lg shadow-sm border border-gray-200" />
                        }
                        <input type="file" name="Banners[@i].FileAnh" accept="image/*" class="w-full text-sm border border-gray-300 bg-white p-2 rounded-lg file-upload mb-3" />
                        <label class="text-xs font-bold text-gray-500 block mb-1">Mô tả ảnh (Alt SEO)</label>
                        <input asp-for="Banners[i].TieuDeAlt" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-indigo-500" placeholder="Nhập mô tả ảnh..." />
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TAB EVENTS ĐẾM NGƯỢC -->
    <div id="tabEvents" class="tab-content hidden space-y-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                <h3 class="text-lg font-bold text-gray-900"><i class="fas fa-stopwatch mr-2 text-[#2e7d32]"></i> Sự Kiện Đếm Ngược</h3>
                <button type="button" class="bg-cyan-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-lg shadow-sm font-bold transition flex items-center gap-2" onclick="addRepeaterItem('repeaterEvents', 'templateEvent')">
                    <i class="fas fa-plus"></i> Thêm Sự Kiện
                </button>
            </div>

            <div id="repeaterEvents" class="space-y-6 mt-4">
                @for (int i = 0; i < Model.ChuongTrinhs.Count; i++)
                {
                    <div class="bg-gray-50 border border-gray-200 p-6 rounded-2xl relative r-item shadow-sm">
                        <button type="button" class="absolute top-4 right-4 bg-white text-red-500 hover:bg-red-50 border border-red-100 h-8 w-8 flex items-center justify-center rounded-lg font-bold shadow-sm transition btn-remove"><i class="fas fa-times"></i></button>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
                            <div><label class="text-xs font-bold text-gray-600 uppercase mb-1">Tiêu đề phụ (Nhỏ ở trên)</label><input asp-for="ChuongTrinhs[i].TieuDePhu" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-cyan-500" /></div>
                            <div><label class="text-xs font-bold text-gray-600 uppercase mb-1">Tiêu đề chính (Chữ to 3D)</label><input asp-for="ChuongTrinhs[i].TieuDeChinh" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm font-bold outline-none focus:border-cyan-500" /></div>
                            <div class="md:col-span-2"><label class="text-xs font-bold text-gray-600 uppercase mb-1">Mô tả ngắn</label><input asp-for="ChuongTrinhs[i].MoTa" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-cyan-500" /></div>

                            <div class="md:col-span-2 border-t border-gray-200 pt-4 mt-1"><label class="text-xs font-bold text-red-600 uppercase mb-1">Dòng text Ngày tháng hiển thị cứng</label><input asp-for="ChuongTrinhs[i].ThoiGianHienThi" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-cyan-500" placeholder="VD: Ngày 22 tháng 09 năm 2026..." /></div>

                            <div class="bg-white p-4 rounded-xl border border-gray-200"><label class="text-xs font-bold text-blue-600 uppercase mb-1">Thời gian BẮT ĐẦU</label><input type="datetime-local" asp-for="ChuongTrinhs[i].ThoiGianBatDau" class="w-full border border-gray-300 rounded-lg p-2 text-sm bg-gray-50" /></div>
                            <div class="bg-white p-4 rounded-xl border border-gray-200"><label class="text-xs font-bold text-red-600 uppercase mb-1">Thời gian KẾT THÚC</label><input type="datetime-local" asp-for="ChuongTrinhs[i].ThoiGianKetThuc" class="w-full border border-gray-300 rounded-lg p-2 text-sm bg-gray-50" /></div>


                            <div class="md:col-span-2 bg-red-50 p-4 rounded-xl border border-red-200 flex items-center">
                                <label class="font-bold text-red-700 cursor-pointer flex items-center gap-3">
                                    <input type="checkbox" asp-for="ChuongTrinhs[i].EpKetThuc" class="w-5 h-5 accent-red-600 rounded" />
                                    Đánh dấu ĐÃ KẾT THÚC (Bỏ qua thời gian, ép dừng sự kiện)
                                </label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- TAB 2: VỀ DỰ ÁN -->
    <div id="tab2" class="tab-content hidden space-y-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
            <h3 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3 mb-5"><i class="fas fa-book-open mr-2 text-[#2e7d32]"></i> Thiết kế phần "Về Dự Án"</h3>

            <div class="mb-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Tiêu đề Về Dự Án</label>
                    <input type="text" asp-for="VeDuAn_TieuDe" class="w-full border border-gray-300 rounded-lg p-3 text-lg font-bold outline-none focus:border-[#2e7d32]" />
                </div>
            </div>

            <label class="block text-sm font-bold text-gray-700 mb-2">Nội dung chi tiết (Rich Text Editor)</label>
            <div class="border border-gray-300 rounded-lg overflow-hidden mb-6 shadow-sm">
                <textarea id="VeDuAn_NoiDung" asp-for="VeDuAn_NoiDung" rows="15" class="w-full border-none outline-none p-2"></textarea>
            </div>

            <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
                <label class="block text-sm font-bold text-gray-700 mb-3">Ảnh đại diện Về Dự Án (Tối đa 2MB)</label>
                <input type="hidden" asp-for="VeDuAn_LinkAnhCu" />
                @if (!string.IsNullOrEmpty(Model.VeDuAn_LinkAnhCu))
                {
                    <img src="@Model.VeDuAn_LinkAnhCu" class="h-40 object-cover rounded-xl mb-4 shadow-sm border border-gray-200" />
                }
                <input type="file" name="VeDuAn_FileAnh" accept="image/*" class="w-full text-sm border p-2 bg-white rounded-lg file-upload" />
            </div>
        </div>
    </div>

    <!-- TAB 3: ẢNH NỔI PARALLAX -->
    <div id="tab3" class="tab-content hidden space-y-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 sm:p-8">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                <h3 class="text-lg font-bold text-gray-900"><i class="fas fa-layer-group mr-2 text-[#2e7d32]"></i> Ảnh Nổi Lơ Lửng (Parallax)</h3>
                <button type="button" class="bg-green-600 hover:bg-green-700 text-white px-5 py-2.5 rounded-lg shadow-sm font-bold transition flex items-center gap-2" onclick="addRepeaterItem('repeaterFloat', 'templateFloat')">
                    <i class="fas fa-plus"></i> Thêm Ảnh Nổi
                </button>
            </div>

            <div id="repeaterFloat" class="space-y-6 mt-4">
                @for (int i = 0; i < Model.AnhNois.Count; i++)
                {
                    <div class="bg-green-50/30 border border-green-100 p-6 rounded-2xl relative r-item shadow-sm">
                        <button type="button" class="absolute top-4 right-4 bg-white text-red-500 hover:bg-red-50 hover:text-red-600 border border-red-100 h-8 w-8 rounded-lg flex items-center justify-center font-bold transition shadow-sm btn-remove"><i class="fas fa-trash-alt"></i></button>
                        <input type="hidden" asp-for="AnhNois[i].LinkAnhCu" />
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-5 pt-2">
                            <div class="md:col-span-2 bg-white p-4 rounded-xl border border-gray-200 shadow-sm">
                                <label class="block text-xs font-bold text-gray-700 mb-2">Tải ảnh lên (Tối đa 2MB)</label>
                                @if (!string.IsNullOrEmpty(Model.AnhNois[i].LinkAnhCu))
                                {
                                    <img src="@Model.AnhNois[i].LinkAnhCu" class="h-20 object-contain mb-3 rounded-lg border border-gray-100" />
                                }
                                <input type="file" name="AnhNois[@i].FileAnh" accept="image/*" class="w-full text-xs border bg-gray-50 p-1.5 rounded file-upload" />
                            </div>
                            <div class="md:col-span-2">
                                <label class="block text-xs font-bold text-gray-600 mb-1">Mô tả (Alt)</label>
                                <input asp-for="AnhNois[i].TieuDeAlt" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none focus:border-green-500" />
                            </div>
                            <div><label class="block text-xs font-bold text-gray-500 mb-1">Top (Y)</label><input asp-for="AnhNois[i].ViTriTop" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none" placeholder="VD: 15%" /></div>
                            <div>
                                <label class="block text-xs font-bold text-gray-500 mb-1">Căn lề</label>
                                <select asp-for="AnhNois[i].CanLe" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm outline-none bg-white">
                                    <option value="left">Trái (Left)</option>
                                    <option value="right">Phải (Right)</option>
                                </select>
                            </div>
