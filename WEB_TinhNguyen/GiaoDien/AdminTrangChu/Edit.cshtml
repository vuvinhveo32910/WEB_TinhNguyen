                }
            </div>
        </div>
    </div>
</form>

<!-- MODAL TẢI LÊN HIỆU ỨNG NHANH BÊN TRONG EDIT.CSHTML -->
<div id="uploadEffectModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 backdrop-blur-sm px-4 transition-opacity">
    <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300" id="uploadEffectModalContent">
        <div class="bg-[#1b5e20] p-5 flex justify-between items-center text-white">
            <h3 class="font-bold text-lg"><i class="fas fa-upload mr-2"></i> Tải lên file Hiệu ứng (.js)</h3>
            <button type="button" onclick="closeUploadEffectModal()" class="text-white/70 hover:text-white transition">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <form asp-action="UploadHieuUngNhanh" method="post" enctype="multipart/form-data" class="p-6">
            <input type="hidden" name="idChienDich" value="@Model.IDChienDich" />
            <div class="space-y-5">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Tên hiệu ứng <span class="text-red-500">*</span></label>
                    <input type="text" name="tenHieuUng" required placeholder="VD: Hoa Mai Rơi"
                           class="w-full border border-gray-300 rounded-xl p-3 focus:border-[#2e7d32] focus:ring-1 focus:ring-green-500 outline-none font-bold" />
                </div>
                <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                    <label class="block text-sm font-bold text-gray-700 mb-2">Chọn file Code (.js) <span class="text-red-500">*</span></label>
                    <input type="file" name="fileJS" accept=".js" required class="w-full text-sm border p-2 bg-white rounded-lg" />
                </div>
            </div>

            <div class="mt-8 flex justify-end gap-3">
                <button type="button" onclick="closeUploadEffectModal()" class="px-5 py-2.5 rounded-xl font-bold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">Hủy</button>
                <button type="submit" class="px-6 py-2.5 rounded-xl font-bold text-white bg-[#2e7d32] hover:bg-green-800 shadow-md transition">Tải lên & Lưu</button>
            </div>
        </form>
    </div>
</div>

