                <button type="button" class="bg-yellow-500 hover:bg-yellow-600 text-white px-5 py-2.5 rounded-lg shadow-sm font-bold transition flex items-center gap-2" onclick="addRepeaterItem('repeaterSponsor', 'templateSponsor')">
