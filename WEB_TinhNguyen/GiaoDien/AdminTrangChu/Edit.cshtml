            <div class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                <h3 class="text-lg font-bold text-gray-900"><i class="fas fa-question-circle mr-2 text-[#2e7d32]"></i> Câu Hỏi Thường Gặp (FAQ)</h3>
                <button type="button" class="bg-purple-600 hover:bg-purple-700 text-white px-5 py-2.5 rounded-lg shadow-sm font-bold transition flex items-center gap-2" onclick="addRepeaterItem('repeaterFAQ', 'templateFAQ')">
                    <i class="fas fa-plus"></i> Thêm Câu Hỏi
                </button>
            </div>

            <div id="repeaterFAQ" class="space-y-5 mt-4">
                @for (int i = 0; i < Model.FAQs.Count; i++)
                {
                    <div class="bg-purple-50/30 border border-purple-100 p-6 rounded-2xl relative r-item shadow-sm">
                        <button type="button" class="absolute top-4 right-4 bg-white text-red-500 hover:bg-red-50 hover:text-red-600 border border-red-100 px-3 py-1.5 rounded-lg text-xs font-bold transition shadow-sm btn-remove"><i class="fas fa-trash-alt mr-1"></i> Xóa câu hỏi</button>
