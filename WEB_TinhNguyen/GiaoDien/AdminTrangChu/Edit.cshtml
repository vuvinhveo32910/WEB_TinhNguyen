@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>

    <script>
        function openUploadEffectModal() {
            const modal = document.getElementById('uploadEffectModal');
            const modalBox = document.getElementById('uploadEffectModalContent');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => { modalBox.classList.remove('scale-95'); }, 10);
        }

        function closeUploadEffectModal() {
            const modal = document.getElementById('uploadEffectModal');
            const modalBox = document.getElementById('uploadEffectModalContent');
            modalBox.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 200);
        }

        function initTinyMCE() {
            try {
                tinymce.remove('#VeDuAn_NoiDung');
                tinymce.init({
                    selector: '#VeDuAn_NoiDung',
                    plugins: 'anchor autolink charmap codesample emoticons link lists media searchreplace table visualblocks wordcount',
                    toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist outdent indent | emoticons charmap | removeformat',
                    menubar: false,
                    height: 450,
                    font_family_formats: 'Be Vietnam Pro=Be Vietnam Pro, sans-serif; Arial=arial,helvetica,sans-serif; Dancing Script=Dancing Script, cursive; Times New Roman=times new roman,times;',
                    content_style: 'body { font-family: "Be Vietnam Pro", sans-serif; font-size: 16px; }',
                    setup: function(editor) {
                        editor.on('init', function() {
                            editor.getContainer().style.transition = "none";
                        });
                    }
                });
            } catch (e) {
                console.warn('TinyMCE init skipped for Về Dự Án');
            }
        }

        function initTinyMCEOnElement(selector) {
            try {
                tinymce.init({
                    selector: selector,
                    plugins: 'anchor autolink charmap codesample emoticons link lists media searchreplace table visualblocks wordcount',
                    toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | forecolor backcolor | alignleft aligncenter alignright alignjustify | bullist numlist | emoticons charmap | removeformat',
                    menubar: false,
                    height: 350,
                    font_family_formats: 'Be Vietnam Pro=Be Vietnam Pro, sans-serif; Arial=arial,helvetica,sans-serif;',
                    setup: function(editor) {
                        editor.on('init', function() { editor.getContainer().style.transition = "none"; });
                    }
                });
            } catch (e) {
                console.warn('TinyMCE init skipped for News item');
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
                    document.querySelectorAll('.tab-btn').forEach(b => {
                        b.classList.remove('text-[#2e7d32]', 'bg-green-50', 'active');
                        b.classList.add('text-gray-500');
                    });

                    const targetId = btn.dataset.target;
                    document.getElementById(targetId).classList.remove('hidden');
                    btn.classList.add('text-[#2e7d32]', 'bg-green-50', 'active');
                    btn.classList.remove('text-gray-500');

                    if (targetId === 'tab2') {
                        setTimeout(() => { initTinyMCE(); }, 100);
                    }
                    if (targetId === 'tab5') {
                        setTimeout(() => { initTinyMCEOnElement('.tinymce-news'); }, 100);
                    }
                });
            });

            setTimeout(() => {
                initTinyMCE();
                initTinyMCEOnElement('.tinymce-news');
            }, 300);

            const configForm = document.getElementById('configForm');
            if (configForm) {
                configForm.addEventListener('submit', function() {
                    if (typeof tinymce !== 'undefined') {
                        tinymce.triggerSave();
                    }

                    document.querySelectorAll('#repeaterEvents .r-item').forEach(item => {
                        const mainTitle = item.querySelector('input[name*="TieuDeChinh"]')?.value?.trim() || '';
                        const subTitle = item.querySelector('input[name*="TieuDePhu"]')?.value?.trim() || '';
                        const desc = item.querySelector('input[name*="MoTa"]')?.value?.trim() || '';
                        if (!mainTitle && !subTitle && !desc) {
                            item.remove();
                        }
                    });

                    document.querySelectorAll('div[id^="repeater"]').forEach(container => {
                        reindexElements(container);
                    });
                });
            }
        });

        window.addRepeaterItem = function(containerId, templateId, isNews = false) {
            const container = document.getElementById(containerId);
            const template = document.getElementById(templateId).innerHTML;
            container.insertAdjacentHTML('beforeend', template);

            const newItem = container.lastElementChild;
            reindexElements(container);

            if (isNews) {
                const textarea = newItem.querySelector('.raw-tinymce-news');
                if (textarea) {
                    const uniqueId = 'news-editor-' + Date.now();
                    textarea.id = uniqueId;
                    textarea.classList.remove('raw-tinymce-news');
                    initTinyMCEOnElement('#' + uniqueId);
                }
            }
        };

        function reindexElements(container) {
            if (!container) return;
            const items = container.querySelectorAll('.r-item');
            items.forEach((item, index) => {
                const inputs = item.querySelectorAll('input, select, textarea');
                inputs.forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/\[\d+\]|\[INDEX\]/g, `[${index}]`));
                    }
                    const id = input.getAttribute('id');
                    if (id) {
                        input.setAttribute('id', id.replace(/_\d+__|__INDEX__/g, `_${index}__`));
                    }
                });
            });
        }

        document.addEventListener('click', (e) => {
            const removeBtn = e.target.closest('.btn-remove');
            if (removeBtn) {
                e.preventDefault();
                if (confirm('Xác nhận xóa mục này?')) {
                    const item = removeBtn.closest('.r-item');
                    const container = item.closest('div[id^="repeater"]');
                    item.remove();
                    reindexElements(container);
                }
            }
        });

        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('file-upload')) {
                const file = e.target.files[0];
                if (file && file.size > 2 * 1024 * 1024) {
                    alert('File ảnh quá lớn! Vui lòng chọn file dưới 2MB.');
                    e.target.value = '';
                }
            }
        });
    </script>
}