                                <div><label class="text-xs font-bold text-rose-600 uppercase mb-1">Lượt Thích</label><input type="number" asp-for="TinTucs[i].LuotThich" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm font-bold text-rose-600 outline-none focus:border-blue-500" /></div>
