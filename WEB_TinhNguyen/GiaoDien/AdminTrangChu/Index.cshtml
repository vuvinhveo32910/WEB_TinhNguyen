@model IEnumerable<WEB_TinhNguyen.MoHinh.ChienDich>
@{
    // TRỎ ĐẾN FILE LAYOUT ADMIN ĐỂ CÓ MENU TRÁI MÀU XANH RỪNG
    Layout = "~/GiaoDien/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý trang Trang chủ";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h2 class="text-2xl font-extrabold text-gray-900 tracking-tight">Quản lý Giao diện Trang chủ</h2>
        <p class="text-sm text-gray-500 mt-1">Quản lý chiến dịch, cấu hình giao diện và chọn năm hiển thị chính thức.</p>
    </div>
    <!-- NÚT MỞ MODAL THÊM MỚI -->
    <button type="button" onclick="openCreateModal()" class="bg-[#1b5e20] hover:bg-green-800 text-white px-5 py-2.5 rounded-xl shadow-md font-bold flex items-center gap-2 transition">
        <i class="fas fa-plus"></i> Thêm Chiến Dịch Mới
    </button>
</div>

<!-- THÔNG BÁO TỪ SERVER -->
@if (TempData["Success"] != null)
{
    <div class="mb-6 flex items-center p-4 text-sm text-emerald-800 border border-emerald-200 rounded-xl bg-emerald-50 shadow-sm">
        <i class="fas fa-check-circle mr-2 text-emerald-600 text-lg"></i>
        <span class="font-semibold">@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="mb-6 flex items-center p-4 text-sm text-red-800 border border-red-200 rounded-xl bg-red-50 shadow-sm">
        <i class="fas fa-exclamation-triangle mr-2 text-red-600 text-lg"></i>
        <span class="font-semibold">@TempData["Error"]</span>
    </div>
}

<!-- BẢNG DỮ LIỆU -->
<div class="bg-white rounded-[20px] shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full">
            <thead>
                <tr class="border-b border-gray-100 bg-gray-50/50">
                    <th class="py-5 px-6 text-left text-[11px] font-bold text-gray-400 uppercase tracking-widest">NĂM CHIẾN DỊCH</th>
                    <th class="py-5 px-6 text-left text-[11px] font-bold text-gray-400 uppercase tracking-widest">TÊN HIỂN THỊ</th>
                    <th class="py-5 px-6 text-center text-[11px] font-bold text-gray-400 uppercase tracking-widest">BẬT/TẮT TRANG CHỦ</th>
                    <th class="py-5 px-6 text-right text-[11px] font-bold text-gray-400 uppercase tracking-widest">THAO TÁC</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-gray-50/50 transition-colors duration-200">
                        <td class="py-4 px-6">
                            <span class="px-3 py-1 bg-green-50 text-[#1b5e20] font-extrabold rounded-lg text-sm border border-green-100">
                                @item.Nam
                            </span>
                        </td>
                        <td class="py-4 px-6 text-sm font-bold text-gray-700">@item.TieuDe</td>

                        <!-- CỘT BẬT TẮT TRẠNG THÁI -->
                        <td class="py-4 px-6 text-center">
                            <form asp-action="ToggleStatus" asp-route-id="@item.IDChienDich" method="post" class="inline-block m-0 p-0">
                                @if (item.TrangThaiHoatDong)
                                {
                                    <button type="submit" title="Bấm để Tắt" class="relative inline-flex h-6 w-12 items-center rounded-full bg-[#4caf50] transition-colors focus:outline-none ring-2 ring-green-200 ring-offset-1">
                                        <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform translate-x-7 shadow-sm"></span>
                                    </button>
                                    <span class="block text-[10px] font-bold text-[#2e7d32] mt-1 uppercase">Đang chạy</span>
                                }
                                else
                                {
                                    <button type="submit" title="Bấm để Bật làm Trang chủ" class="relative inline-flex h-6 w-12 items-center rounded-full bg-gray-300 transition-colors focus:outline-none hover:bg-gray-400">
                                        <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform translate-x-1 shadow-sm"></span>
                                    </button>
                                    <span class="block text-[10px] font-bold text-gray-400 mt-1 uppercase">Đang tắt</span>
                                }
                            </form>
                        </td>

                        <!-- CỘT THAO TÁC (CẤU HÌNH / XÓA) -->
                        <td class="py-4 px-6 text-right space-x-2 whitespace-nowrap">
                            <a href="@Url.Action("Edit", "AdminTrangChu", new { id = item.IDChienDich })"
                               class="inline-flex items-center gap-1.5 px-4 py-2 text-[13px] font-bold text-indigo-600 bg-indigo-50 border border-indigo-100 rounded-xl hover:bg-indigo-600 hover:text-white transition">
                                <i class="fas fa-cog"></i> Cấu hình
                            </a>

                            <form asp-action="DeleteChienDich" asp-route-id="@item.IDChienDich" method="post" class="inline-block m-0 p-0" onsubmit="return confirm('Bạn có CHẮC CHẮN muốn xóa toàn bộ chiến dịch năm @item.Nam không? Mọi dữ liệu cấu hình trang chủ của năm này sẽ bị xóa vĩnh viễn!');">
                                <button type="submit" class="inline-flex items-center justify-center w-9 h-9 text-red-500 bg-red-50 border border-red-100 rounded-xl hover:bg-red-600 hover:text-white transition" title="Xóa chiến dịch">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-12">
            <i class="fas fa-folder-open text-4xl text-gray-200 mb-3 block"></i>
            <p class="text-gray-400 text-sm font-medium">Chưa có dữ liệu chiến dịch nào. Hãy bấm "Thêm Chiến Dịch Mới" ở góc trên bên phải!</p>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- MODAL THÊM CHIẾN DỊCH MỚI (POPUP HIỆN RA KHI BẤM NÚT) -->
<!-- ========================================== -->
<div id="createModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 backdrop-blur-sm px-4 transition-opacity">
    <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300" id="createModalContent">

        <div class="bg-[#1b5e20] p-5 flex justify-between items-center text-white">
            <h3 class="font-bold text-lg"><i class="fas fa-plus-circle mr-2"></i> Thêm Chiến Dịch Mới</h3>
            <button type="button" onclick="closeCreateModal()" class="text-white/70 hover:text-white transition">
                <i class="fas fa-times text-xl"></i>
            </button>
        </div>

        <form asp-action="CreateChienDich" method="post" class="p-6">
            <div class="space-y-5">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Năm tổ chức <span class="text-red-500">*</span></label>
                    <input type="number" name="Nam" required value="@DateTime.Now.Year" min="2000" max="2100"
                           class="w-full border border-gray-300 rounded-xl p-3 focus:border-[#2e7d32] focus:ring-1 focus:ring-green-500 outline-none font-bold text-lg" />
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1">Tên Tiêu đề / Chủ đề <span class="text-red-500">*</span></label>
                    <input type="text" name="TieuDe" required placeholder="VD: Trăng Sáng Langbiang 2026"
                           class="w-full border border-gray-300 rounded-xl p-3 focus:border-[#2e7d32] focus:ring-1 focus:ring-green-500 outline-none" />
                </div>
            </div>

            <div class="mt-8 flex justify-end gap-3">
                <button type="button" onclick="closeCreateModal()" class="px-5 py-2.5 rounded-xl font-bold text-gray-600 bg-gray-100 hover:bg-gray-200 transition">Hủy</button>
                <button type="submit" class="px-6 py-2.5 rounded-xl font-bold text-white bg-[#2e7d32] hover:bg-green-800 shadow-md transition">Tạo mới</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateModal() {
            const modal = document.getElementById('createModal');
            const modalBox = document.getElementById('createModalContent');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => { modalBox.classList.remove('scale-95'); }, 10);
        }

        function closeCreateModal() {
            const modal = document.getElementById('createModal');
            const modalBox = document.getElementById('createModalContent');
            modalBox.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 200);
        }
    </script>
}