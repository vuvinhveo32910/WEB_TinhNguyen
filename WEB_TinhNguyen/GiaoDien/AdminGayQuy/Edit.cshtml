@section Scripts {
    <script>
        // Chuyển đổi Tabs
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('active', 'text-emerald-700', 'bg-emerald-50');
                    b.classList.add('text-gray-500');
                });
                document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));

                btn.classList.remove('text-gray-500');
                btn.classList.add('active', 'text-emerald-700', 'bg-emerald-50');
                document.getElementById(btn.dataset.target).classList.remove('hidden');
            });
        });

        // Thêm phần tử Repeater
        window.addRepeaterItem = function (containerId, templateId) {
            const container = document.getElementById(containerId);
            const template = document.getElementById(templateId).innerHTML;
            container.insertAdjacentHTML('beforeend', template);
            reindexElements(container);
        };

        // Đánh lại chỉ mục [0], [1], [2]... để Model Binding của ASP.NET Core nhận đủ danh sách
        function reindexElements(container) {
            const items = container.querySelectorAll('.r-item');
            items.forEach((item, index) => {
                item.querySelectorAll('input, select, textarea').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/\[\d+\]|\[INDEX\]/g, `[${index}]`));
                    }
                });
            });
        }

        // Xóa phần tử Repeater
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('btn-remove')) {
                if (confirm('Bạn có chắc muốn xóa mục này?')) {
                    const item = e.target.closest('.r-item');
                    const container = item.parentElement;
                    item.remove();
                    reindexElements(container);
                }
            }
        });
    </script>
}