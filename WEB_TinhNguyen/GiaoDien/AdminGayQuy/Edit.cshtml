@model WEB_TinhNguyen.MoHinh.CauHinhGayQuyVM
@{
    ViewData["Title"] = "Cấu hình Gây Quỹ - " + Model.TenChienDich;
    Layout = "~/GiaoDien/Shared/_AdminLayout.cshtml";
}

<div class="max-w-7xl mx-auto my-8 px-4 sm:px-6 lg:px-8">
    <!-- HEADER -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-200 pb-5">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
                <a href="@Url.Action("Index", "AdminGayQuy")" class="hover:text-emerald-600 font-medium">← Quay lại danh sách</a>
                <span>/</span>
                <span>Mùa @Model.NamChienDich</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">
                Cấu hình Trang Đóng Góp & Gây Quỹ - <span class="text-emerald-600">@Model.TenChienDich</span>
            </h2>
        </div>
        <div class="flex items-center gap-3">
            <a href="@Url.Action("GayQuy", "Home", new { year = Model.NamChienDich })" target="_blank"
               class="inline-flex items-center px-4 py-2.5 border border-gray-300 text-sm font-semibold rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-sm transition">
                👁️ Xem thử trang thật
            </a>
            <button type="submit" form="gayQuyForm"
                    class="inline-flex items-center px-6 py-2.5 text-sm font-bold rounded-xl text-white bg-emerald-600 hover:bg-emerald-700 shadow-md transition">
                💾 Lưu Toàn Bộ Cấu Hình
            </button>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="gayQuyForm">
        <input type="hidden" asp-for="IDCauHinhGQ" />
        <input type="hidden" asp-for="IDChienDich" />
        <input type="hidden" asp-for="TenChienDich" />
        <input type="hidden" asp-for="NamChienDich" />

        <!-- THANH ĐIỀU HƯỚNG TABS -->
        <div class="bg-white rounded-t-2xl border-x border-t border-gray-200 px-3 pt-3">
            <div class="flex space-x-2 overflow-x-auto pb-2">
                <button type="button" class="tab-btn active shrink-0 px-4 py-2.5 text-sm font-bold rounded-xl text-emerald-700 bg-emerald-50 transition" data-target="tabGeneral">
                    🎨 1. Font & Màu Chủ Đạo
                </button>
                <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-xl text-gray-500 hover:bg-gray-50 transition" data-target="tabHero">
                    🌟 2. Khu vực Mở đầu (Hero)
                </button>
                <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-xl text-gray-500 hover:bg-gray-50 transition" data-target="tabChannels">
                    💳 3. Kênh Đóng Góp & QR
                </button>
                <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-xl text-gray-500 hover:bg-gray-50 transition" data-target="tabReport">
                    📊 4. Báo Cáo Thu – Chi
                </button>
                <button type="button" class="tab-btn shrink-0 px-4 py-2.5 text-sm font-bold rounded-xl text-gray-500 hover:bg-gray-50 transition" data-target="tabSponsors">
                    🤝 5. Đơn Vị Tổ Chức & Tài Trợ
                </button>
            </div>
        </div>

        <!-- NỘI DUNG TABS -->
        <div class="bg-gray-50 rounded-b-2xl border border-gray-200 p-6 sm:p-8 shadow-sm">

            <!-- ============================================== -->
            <!-- TAB 1: CẤU HÌNH FONT CHỮ & MÀU CHỦ ĐẠO TOÀN TRANG -->
            <!-- ============================================== -->
            <div id="tabGeneral" class="tab-content block space-y-6">
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                    <h3 class="text-lg font-bold text-gray-900 border-b pb-3 mb-5">Thiết lập Font chữ & Màu sắc chung</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Font chữ Tiêu đề (Google Fonts)</label>
                            <input type="text" asp-for="FontTieuDe" list="fontList" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-500" placeholder="VD: Be Vietnam Pro" />
                            <datalist id="fontList">
                                <option value="Be Vietnam Pro"></option>
                                <option value="Dancing Script"></option>
                                <option value="Montserrat"></option>
                                <option value="Playfair Display"></option>
                                <option value="Quicksand"></option>
                            </datalist>
                            <p class="text-xs text-gray-400 mt-1">Áp dụng cho các thẻ H1, H2, H3 trong trang.</p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Font chữ Nội dung (Body)</label>
                            <input type="text" asp-for="FontNoiDung" list="fontList" class="w-full border border-gray-300 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-500" placeholder="VD: Be Vietnam Pro" />
                            <p class="text-xs text-gray-400 mt-1">Áp dụng cho đoạn văn, ghi chú, nút bấm.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 2: SECTION 1 - HERO BANNER                 -->
            <!-- ============================================== -->
            <div id="tabHero" class="tab-content hidden space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Cột trái: Nội dung chữ -->
                    <div class="lg:col-span-2 bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-5">
                        <h3 class="text-lg font-bold text-gray-900 border-b pb-3">Nội dung khối Mở đầu (Hero)</h3>

                        <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
                            <div>
                                <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Nhãn nhỏ (Badge)</label>
                                <input type="text" asp-for="Hero_Nhan" class="w-full border rounded-lg p-2 text-sm font-semibold" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div class="sm:col-span-2">
                                <label class="block text-sm font-semibold text-gray-700 mb-1">Tiêu đề chính (H1)</label>
                                <input type="text" asp-for="Hero_TieuDe" class="w-full border rounded-xl p-2.5 font-bold" />
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-1">Cỡ chữ (VD: 48px)</label>
                                <input type="text" asp-for="Hero_CoChuTieuDe" class="w-full border rounded-xl p-2.5" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Đoạn văn mô tả</label>
                            <textarea asp-for="Hero_MoTa" rows="4" class="w-full border rounded-xl p-3 text-sm"></textarea>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-emerald-50/50 p-4 rounded-xl border border-emerald-100">
                            <div>
                                <label class="block text-xs font-bold text-emerald-800 mb-1">Chữ trên Nút bấm</label>
                                <input type="text" asp-for="Hero_TextNut" class="w-full border rounded-lg p-2 text-sm" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-emerald-800 mb-1">Link khi bấm nút</label>
                                <input type="text" asp-for="Hero_LinkNut" class="w-full border rounded-lg p-2 text-sm" />
                            </div>
                        </div>
                    </div>

                    <!-- Cột phải: Ảnh -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-6">
                        <h3 class="text-lg font-bold text-gray-900 border-b pb-3">Ảnh Hero</h3>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Ảnh khung bên phải (Tối đa 2MB)</label>
                            <input type="hidden" asp-for="Hero_LinkAnhCu" />
                            @if (!string.IsNullOrEmpty(Model.Hero_LinkAnhCu))
                            {
                                <img src="@Model.Hero_LinkAnhCu" class="w-full h-44 object-cover rounded-xl mb-3 shadow border" />
                            }
                            <input type="file" asp-for="Hero_FileAnh" accept="image/*" class="w-full text-sm border p-2 rounded-lg file-upload" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 3: SECTION 2 - KÊNH ĐÓNG GÓP & TÀI KHOẢN QR -->
            <!-- ============================================== -->
            <div id="tabChannels" class="tab-content hidden space-y-6">
                <!-- Tiêu đề khu vực -->
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                    <h3 class="text-lg font-bold text-gray-900 border-b pb-3 mb-4">Tiêu đề Khu vực "Cách thức đóng góp"</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Nhãn phụ (Badge)</label>
                            <input type="text" asp-for="DongGop_Nhan" class="w-full border rounded-lg p-2" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Tiêu đề chính (H2)</label>
                            <input type="text" asp-for="DongGop_TieuDe" class="w-full border rounded-lg p-2 font-bold" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Mô tả ngắn phía dưới tiêu đề</label>
                            <input type="text" asp-for="DongGop_MoTa" class="w-full border rounded-lg p-2" />
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Dòng ghi chú cam kết nhỏ ở dưới cùng các thẻ</label>
                            <input type="text" asp-for="DongGop_GhiChuChanTrang" class="w-full border rounded-lg p-2 text-sm text-gray-600" />
                        </div>
                    </div>
                </div>

                <!-- Danh sách thẻ Kênh đóng góp -->
                <div class="flex items-center justify-between">
                    <h3 class="text-lg font-bold text-gray-800">Danh sách các Thẻ (Card) Kênh Đóng Góp</h3>
                    <button type="button" onclick="addRepeaterItem('repeaterChannels', 'templateChannel')"
                            class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold px-4 py-2 rounded-xl shadow-sm transition">
                        + Thêm Thẻ Đóng Góp Mới
                    </button>
                </div>

                <div id="repeaterChannels" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    @for (int i = 0; i < Model.KenhDongGops.Count; i++)
                    {
                        <div class="bg-white border-2 border-emerald-100 rounded-2xl p-6 shadow-sm relative r-item space-y-4">
                            <button type="button" class="absolute top-4 right-4 bg-red-50 text-red-600 hover:bg-red-600 hover:text-white px-3 py-1 rounded-lg text-xs font-bold transition btn-remove">
                                ✕ Xóa thẻ
                            </button>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Tên hình thức đóng góp</label>
                                    <input asp-for="KenhDongGops[i].TenKenh" class="w-full border rounded-lg p-2 font-bold text-gray-900" placeholder="VD: Quyên góp trực tiếp" />
                                </div>
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Nội dung mô tả</label>
                                    <textarea asp-for="KenhDongGops[i].MoTa" rows="3" class="w-full border rounded-lg p-2 text-sm"></textarea>
                                </div>

                                <!-- Tùy chỉnh Icon & Màu sắc Card -->
                                <div>
                                    <label class="block text-xs font-bold text-gray-600 uppercase mb-1">Biểu tượng (Icon)</label>
                                    <select asp-for="KenhDongGops[i].LoaiIcon" class="w-full border rounded-lg p-2 text-sm bg-white">
                                        <option value="bank">💳 Ví / Tài khoản ngân hàng</option>
                                        <option value="gift">🎁 Quà tặng / Hiện vật</option>
                                        <option value="heart">💚 Trái tim yêu thương</option>
                                        <option value="star">⭐ Ngôi sao đồng hành</option>
                                    </select>
                                </div>

                                <!-- Cấu hình Nút bấm & Hành động -->
                                <div>
                                    <label class="block text-xs font-bold text-emerald-700 uppercase mb-1">Chữ trên Nút bấm</label>
                                    <input asp-for="KenhDongGops[i].TextNut" class="w-full border rounded-lg p-2 text-sm font-semibold" placeholder="VD: QR Tài khoản" />
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-emerald-700 uppercase mb-1">Khi bấm nút sẽ làm gì?</label>
                                    <select asp-for="KenhDongGops[i].LoaiHanhDong" class="w-full border rounded-lg p-2 text-sm bg-emerald-50 font-semibold text-emerald-900">
                                        <option value="qr">Mở Bảng Mã QR Ngân Hàng</option>
                                        <option value="link">Chuyển hướng sang Link khác</option>
                                    </select>
                                </div>

                                <!-- Khối Link ngoài -->
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-semibold text-gray-600 mb-1">Link chuyển hướng (Nếu chọn Chuyển hướng sang Link khác)</label>
                                    <input asp-for="KenhDongGops[i].LinkNgoai" class="w-full border rounded-lg p-2 text-sm" placeholder="https://www.facebook.com/..." />
                                </div>

                                <!-- Khối cấu hình QR Ngân hàng -->
                                <div class="sm:col-span-2 bg-gray-50 p-4 rounded-xl border border-gray-200 space-y-3">
                                    <p class="text-xs font-bold uppercase text-indigo-700">📌 Thông tin hiển thị trong Popup QR Ngân Hàng:</p>
                                    <input type="hidden" asp-for="KenhDongGops[i].LinkAnhQRCu" />
                                    <div class="flex items-center gap-4">
                                        @if (!string.IsNullOrEmpty(Model.KenhDongGops[i].LinkAnhQRCu))
                                        {
                                            <img src="@Model.KenhDongGops[i].LinkAnhQRCu" class="h-20 w-20 object-contain bg-white p-1 rounded border shadow-sm" />
                                        }
                                        <div class="flex-1">
                                            <label class="block text-xs font-semibold text-gray-600 mb-1">Ảnh Mã QR (Tối đa 2MB)</label>
                                            <input type="file" name="KenhDongGops[@i].FileAnhQR" accept="image/*" class="w-full text-xs border bg-white p-1.5 rounded file-upload" />
                                        </div>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs text-gray-500">Tên Ngân Hàng</label>
                                            <input asp-for="KenhDongGops[i].TenNganHang" class="w-full border rounded p-1.5 text-sm bg-white" placeholder="VD: MB Bank" />
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-500">Số Tài Khoản</label>
                                            <input asp-for="KenhDongGops[i].SoTaiKhoan" class="w-full border rounded p-1.5 text-sm font-bold bg-white" placeholder="VD: 0924044283" />
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-500">Tên Chủ Tài Khoản</label>
                                            <input asp-for="KenhDongGops[i].TenChuTaiKhoan" class="w-full border rounded p-1.5 text-sm bg-white" placeholder="VD: NGUYEN ANH HAO" />
                                        </div>
                                        <div>
                                            <label class="block text-xs text-gray-500">Cú pháp Chuyển khoản gợi ý</label>
                                            <input asp-for="KenhDongGops[i].NoiDungChuyenKhoan" class="w-full border rounded p-1.5 text-sm bg-white" placeholder="VD: Langbiang - Nguyen Van A" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 4: SECTION 3 - BÁO CÁO THU CHI             -->
            <!-- ============================================== -->
            <div id="tabReport" class="tab-content hidden space-y-6">
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-5">
                    <h3 class="text-lg font-bold text-gray-900 border-b pb-3">Cấu hình Khu vực "Báo cáo thu – chi"</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Nhãn nhỏ (Badge)</label>
                            <input type="text" asp-for="BaoCao_Nhan" class="w-full border rounded-xl p-2.5" />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Tiêu đề chính (H2)</label>
                            <input type="text" asp-for="BaoCao_TieuDe" class="w-full border rounded-xl p-2.5 font-bold" />
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Đoạn văn mô tả</label>
                            <textarea asp-for="BaoCao_MoTa" rows="2" class="w-full border rounded-xl p-2.5"></textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Chữ trên Nút bấm</label>
                            <input type="text" asp-for="BaoCao_TextNut" class="w-full border rounded-xl p-2.5 font-semibold" />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-1">Đường dẫn (Link Google Drive / Sheet báo cáo)</label>
                            <input type="text" asp-for="BaoCao_LinkNut" class="w-full border rounded-xl p-2.5 text-blue-600" placeholder="https://drive.google.com/..." />
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 5: SECTION 4 - ĐƠN VỊ TÀI TRỢ & TỔ CHỨC    -->
            <!-- ============================================== -->
            <div id="tabSponsors" class="tab-content hidden space-y-6">
                <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                    <h3 class="text-lg font-bold text-gray-900 border-b pb-3 mb-4">Tiêu đề Khu vực "Đơn vị Tổ chức - Tài trợ"</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Nhãn phụ phía trên</label>
                            <input type="text" asp-for="TaiTro_Nhan" class="w-full border rounded-lg p-2" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Tiêu đề chính</label>
                            <input type="text" asp-for="TaiTro_TieuDe" class="w-full border rounded-lg p-2 font-bold" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-amber-600 mb-1">Chữ nổi bật vàng cam (Highlight)</label>
                            <input type="text" asp-for="TaiTro_TieuDeNoiBat" class="w-full border rounded-lg p-2 font-bold text-amber-600" placeholder="VD: NĂM 2026" />
                        </div>
                        <div class="md:col-span-3">
                            <label class="block text-xs font-bold uppercase text-gray-500 mb-1">Mô tả ngắn</label>
                            <input type="text" asp-for="TaiTro_MoTa" class="w-full border rounded-lg p-2" />
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-gray-800">Danh sách Logo Các Đơn Vị</h3>
                        <p class="text-xs text-gray-500">Các đơn vị có cùng tên "Nhóm tài trợ" sẽ tự động được gom chung vào một hàng trên giao diện.</p>
                    </div>
                    <button type="button" onclick="addRepeaterItem('repeaterSponsors', 'templateSponsor')"
                            class="bg-amber-500 hover:bg-amber-600 text-white font-semibold px-4 py-2 rounded-xl shadow-sm transition">
                        + Thêm Đơn Vị Mới
                    </button>
                </div>

                <datalist id="sponsorGroups">
                    <option value="Đơn vị tổ chức năm @Model.NamChienDich"></option>
                    <option value="Đơn vị tài trợ @Model.NamChienDich"></option>
                    <option value="Đơn vị phối hợp (chặng 1)"></option>
                    <option value="Đơn vị đồng hành truyền thông"></option>
                </datalist>

                <div id="repeaterSponsors" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @for (int i = 0; i < Model.NhaTaiTros.Count; i++)
                    {
                        <div class="bg-white border border-gray-200 rounded-2xl p-5 shadow-sm relative r-item space-y-3">
                            <button type="button" class="absolute top-3 right-3 text-red-500 hover:bg-red-50 px-2.5 py-1 rounded-lg text-xs font-bold btn-remove">✕ Xóa</button>
                            <input type="hidden" asp-for="NhaTaiTros[i].LinkLogoCu" />

                            <div class="flex items-center gap-4">
                                @if (!string.IsNullOrEmpty(Model.NhaTaiTros[i].LinkLogoCu))
                                {
                                    <img src="@Model.NhaTaiTros[i].LinkLogoCu" class="h-16 w-24 object-contain bg-gray-50 p-2 rounded-lg border" />
                                }
                                <div class="flex-1">
                                    <label class="block text-xs font-bold text-gray-600 mb-1">Upload Logo (PNG/WebP)</label>
                                    <input type="file" name="NhaTaiTros[@i].FileLogo" accept="image/*" class="w-full text-xs border p-1.5 rounded bg-gray-50 file-upload" />
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-600">Nhóm (Phân tầng hiển thị)</label>
                                    <input asp-for="NhaTaiTros[i].NhomTaiTro" list="sponsorGroups" class="w-full border rounded-lg p-2 text-sm font-semibold text-emerald-800" placeholder="VD: Đơn vị tài trợ 2026" />
                                </div>
