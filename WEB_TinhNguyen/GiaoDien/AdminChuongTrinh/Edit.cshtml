@model WEB_TinhNguyen.MoHinh.CauHinhChuongTrinhVM
@{
    ViewData["Title"] = "Cấu hình Chương trình - " + Model.NamChienDich;
    Layout = "~/GiaoDien/Shared/_AdminLayout.cshtml";
}

<div class="p-6 bg-gray-50 min-h-screen">
    <div class="mb-6 flex justify-between items-center">
        <h2 class="text-2xl font-bold text-gray-800">Cấu hình Chương trình - Mùa @Model.NamChienDich</h2>
        <a href="@Url.Action("Index", "AdminChuongTrinh")" class="text-gray-600 hover:text-gray-900 font-medium">⬅ Quay lại danh sách</a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data" method="post" class="space-y-6">
        <input type="hidden" asp-for="IDCauHinhCT" />
        <input type="hidden" asp-for="IDChienDich" />
        <input type="hidden" asp-for="LinkAnhHero1Cu" />
        <input type="hidden" asp-for="LinkAnhHero2Cu" />

        <!-- 1. CSS GIAO DIỆN -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-lg font-bold text-indigo-700 mb-4 border-b pb-2">🎨 Cấu hình Giao diện (CSS)</h3>
            <div>
                <label class="block text-sm mb-1">Font Tiêu đề (Google Fonts)</label>
                <input type="text" asp-for="FontTieuDe" class="w-full border p-2 rounded text-sm" />
            </div>
        </div>

        <!-- 2. HERO SECTION -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <h3 class="text-lg font-bold text-indigo-700 mb-4 border-b pb-2">🌟 Hero Section</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div><label class="block text-sm font-bold mb-1">Tiêu đề (Màu thường)</label><input type="text" asp-for="TieuDeChinh" class="w-full border p-2 rounded" placeholder="VD: Hành Trình Lan Tỏa" /></div>
                    <div><label class="block text-sm font-bold mb-1 text-green-600">Tiêu đề (Màu nhấn Gradient)</label><input type="text" asp-for="TieuDeNhanManh" class="w-full border p-2 rounded" placeholder="VD: Yêu Thương và Hy Vọng" /></div>
                    <div><label class="block text-sm font-bold mb-1">Mô tả chi tiết</label><textarea asp-for="DoanVanMoTa" rows="4" class="w-full border p-2 rounded"></textarea></div>
                </div>
                <div class="space-y-4 bg-gray-50 p-4 rounded-lg border">
                    <div>
                        <label class="block text-sm font-bold mb-1 text-indigo-600">Ảnh Banner 1 (Nằm nền phía dưới)</label>
                        <input type="file" asp-for="FileAnhHero1" class="w-full border p-2 rounded bg-white" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.LinkAnhHero1Cu))
                        {
                            <img src="@Model.LinkAnhHero1Cu" class="mt-2 h-24 object-cover rounded shadow" />
                        }
                    </div>
                    <div>
                        <label class="block text-sm font-bold mb-1 text-orange-600">Ảnh Banner 2 (Nằm đè lên phía trước)</label>
                        <input type="file" asp-for="FileAnhHero2" class="w-full border p-2 rounded bg-white" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.LinkAnhHero2Cu))
                        {
                            <img src="@Model.LinkAnhHero2Cu" class="mt-2 h-24 object-cover rounded shadow" />
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. DANH SÁCH CÁC CHẶNG -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
                <h3 class="text-lg font-bold text-indigo-700">📍 Quản lý Lộ trình Các Chặng</h3>
                <button type="button" onclick="addStageRow()" class="bg-indigo-600 text-white px-4 py-2 rounded text-sm hover:bg-indigo-700">➕ Thêm Chặng Mới</button>
            </div>

            <div id="stagesContainer" class="space-y-8">
                @for (int i = 0; i < Model.Changs.Count; i++)
                {
                    <div class="border border-gray-300 p-5 rounded-lg bg-gray-50 relative shadow-sm" id="stageRow_@i">
                        <button type="button" onclick="removeStage('stageRow_@i')" class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 rounded text-xs font-bold hover:bg-red-600">X Xóa Chặng Này</button>
                        <h4 class="font-bold text-gray-700 mb-4 border-b pb-2">Chặng @(i + 1)</h4>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-3">
                                <input type="hidden" name="Changs[@i].LinkAnhCu" value="@Model.Changs[i].LinkAnhCu" />
                                <div><label class="block text-xs font-bold">Nhãn Thời gian</label><input type="text" name="Changs[@i].NhanThoiGian" value="@Model.Changs[i].NhanThoiGian" class="w-full border p-2 rounded text-sm" placeholder="VD: Ngày 22 tháng 09 năm 2026" /></div>
                                <div><label class="block text-xs font-bold">Tiêu đề Chặng</label><input type="text" name="Changs[@i].TieuDeChang" value="@Model.Changs[i].TieuDeChang" class="w-full border p-2 rounded text-sm font-bold text-green-700" placeholder="VD: CHẶNG 1: Tại TP.HCM" /></div>
                                <div><label class="block text-xs font-bold">Địa điểm chi tiết</label><input type="text" name="Changs[@i].DiaDiem" value="@Model.Changs[i].DiaDiem" class="w-full border p-2 rounded text-sm" /></div>
                                <div><label class="block text-xs font-bold">Mô tả Chặng</label><textarea name="Changs[@i].MoTaChang" rows="3" class="w-full border p-2 rounded text-sm">@Model.Changs[i].MoTaChang</textarea></div>
                                <div>
                                    <label class="block text-xs font-bold">Upload Ảnh Chặng</label>
                                    <input type="file" name="Changs[@i].FileAnh" class="w-full border p-2 rounded text-sm bg-white" />
                                    @if (!string.IsNullOrEmpty(Model.Changs[i].LinkAnhCu))
                                    {
                                        <img src="@Model.Changs[i].LinkAnhCu" class="mt-2 h-20 rounded" />
                                    }
                                </div>
                            </div>

                            <!-- Lộ trình con -->
                            <div class="bg-white p-4 border rounded shadow-inner">
                                <div class="flex justify-between items-center mb-3 border-b pb-2">
                                    <label class="block text-sm font-bold text-indigo-700">Chi tiết Lộ trình</label>
                                    <button type="button" onclick="addTimelineRow(@i)" class="bg-green-500 text-white px-2 py-1 rounded text-xs">➕ Thêm Mốc T.Gian</button>
                                </div>
                                <div id="timelineContainer_@i" class="space-y-2">
                                    @for (int j = 0; j < Model.Changs[i].LoTrinhs.Count; j++)
                                    {
                                        <div class="flex gap-2 items-center" id="tlRow_@(i)_@(j)">
                                            <input type="text" name="Changs[@i].LoTrinhs[@j].ThoiGian" value="@Model.Changs[i].LoTrinhs[j].ThoiGian" class="w-24 border p-1.5 rounded text-xs font-bold" placeholder="VD: 13g30" />
                                            <input type="text" name="Changs[@i].LoTrinhs[@j].NoiDungHoatDong" value="@Model.Changs[i].LoTrinhs[j].NoiDungHoatDong" class="flex-1 border p-1.5 rounded text-xs" placeholder="Nội dung hoạt động..." />
                                            <button type="button" onclick="removeTimeline('tlRow_@(i)_@(j)')" class="text-red-500 font-bold px-2 hover:bg-red-50">X</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="fixed bottom-0 right-0 left-64 bg-white border-t p-4 flex justify-end shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)] z-50">
            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-transform transform hover:scale-105">
                💾 LƯU CHƯƠNG TRÌNH
            </button>
        </div>
        <div class="h-20"></div>
    </form>
</div>

<script>
    let stageIdx = @Model.Changs.Count;
    let timelineCounters = {};
        @for (int i = 0; i < Model.Changs.Count; i++)
        {
            <text>timelineCounters[@i] = @Model.Changs[i].LoTrinhs.Count;</text>
        }

        function addStageRow() {
            timelineCounters[stageIdx] = 0;
            const html = `
                <div class="border border-green-300 p-5 rounded-lg bg-green-50 relative shadow-sm" id="stageRow_${stageIdx}">
                    <button type="button" onclick="removeStage('stageRow_${stageIdx}')" class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 rounded text-xs font-bold hover:bg-red-600">X Xóa</button>
                    <h4 class="font-bold text-green-800 mb-4 border-b border-green-200 pb-2">Chặng mới thêm</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-3">
                            <div><label class="block text-xs font-bold">Nhãn Thời gian</label><input type="text" name="Changs[${stageIdx}].NhanThoiGian" class="w-full border p-2 rounded text-sm" placeholder="VD: Ngày 22/09/2026"/></div>
                            <div><label class="block text-xs font-bold">Tiêu đề Chặng</label><input type="text" name="Changs[${stageIdx}].TieuDeChang" class="w-full border p-2 rounded text-sm font-bold text-green-700" placeholder="VD: CHẶNG 1: Tại TP.HCM" /></div>
                            <div><label class="block text-xs font-bold">Địa điểm</label><input type="text" name="Changs[${stageIdx}].DiaDiem" class="w-full border p-2 rounded text-sm" placeholder="Nhập địa điểm..."/></div>
                            <div><label class="block text-xs font-bold">Mô tả Chặng</label><textarea name="Changs[${stageIdx}].MoTaChang" rows="3" class="w-full border p-2 rounded text-sm"></textarea></div>
                            <div><label class="block text-xs font-bold text-red-600">Ảnh Chặng</label><input type="file" name="Changs[${stageIdx}].FileAnh" class="w-full border p-2 rounded text-sm bg-white" required/></div>
                        </div>
                        <div class="bg-white p-4 border rounded shadow-inner">
                            <div class="flex justify-between items-center mb-3 border-b pb-2">
                                <label class="block text-sm font-bold text-indigo-700">Chi tiết Lộ trình</label>
                                <button type="button" onclick="addTimelineRow(${stageIdx})" class="bg-green-500 text-white px-2 py-1 rounded text-xs">➕ Thêm Mốc T.Gian</button>
                            </div>
                            <div id="timelineContainer_${stageIdx}" class="space-y-2"></div>
                        </div>
                    </div>
                </div>`;
            document.getElementById('stagesContainer').insertAdjacentHTML('beforeend', html);
            stageIdx++;
        }

    function addTimelineRow(cIdx) {
        let tIdx = timelineCounters[cIdx]++;
        const html = `
                <div class="flex gap-2 items-center" id="tlRow_${cIdx}_${tIdx}">
                    <input type="text" name="Changs[${cIdx}].LoTrinhs[${tIdx}].ThoiGian" class="w-24 border p-1.5 rounded text-xs font-bold" placeholder="VD: 13g30" required/>
                    <input type="text" name="Changs[${cIdx}].LoTrinhs[${tIdx}].NoiDungHoatDong" class="flex-1 border p-1.5 rounded text-xs" placeholder="Nội dung hoạt động..." required/>
                    <button type="button" onclick="removeTimeline('tlRow_${cIdx}_${tIdx}')" class="text-red-500 font-bold px-2 hover:bg-red-50">X</button>
                </div>`;
        document.getElementById(`timelineContainer_${cIdx}`).insertAdjacentHTML('beforeend', html);
    }

    function removeStage(id) { if (confirm("Bạn có chắc chắn muốn xóa chặng này?")) document.getElementById(id).remove(); }
    function removeTimeline(id) { document.getElementById(id).remove(); }
</script>