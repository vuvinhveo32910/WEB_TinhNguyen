<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị Trăng Sáng Langbiang</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Font chữ Be Vietnam Pro -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
            body {
                font-family: 'Be Vietnam Pro', sans-serif;
                background-color: #f4f7fe;
            }

            /* =================================================================
                       SIDEBAR "BOYS - TECH" STYLE CÓ THỂ MỞ RỘNG (HOVER TO EXPAND)
                       ================================================================= */
            .sidebar-container {
                /* Chiều rộng mặc định khi thu gọn (Chỉ hiện Icon) */
                width: 85px;
                background: #161a2d;
                border-bottom-right-radius: 25px;
                border-top-right-radius: 25px;
                transition: all 0.4s ease;
                box-shadow: 4px 0 20px rgba(0,0,0,0.1);
                padding: 20px 0; /* Bỏ padding ngang để icon căn giữa */
                margin-right: 15px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                z-index: 50;
            }

                /* HIỆU ỨNG KHI RÊ CHUỘT VÀO SIDEBAR -> NỞ RA CHIỀU RỘNG MỚI */
                .sidebar-container:hover {
                    width: 280px;
                    padding: 20px 15px; /* Thêm lại padding khi mở rộng để chữ không sát viền */
                }

            /* --- LOGO HEADER --- */
            .sidebar-header {
                display: flex;
                align-items: center;
                gap: 12px;
                padding-bottom: 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                margin-bottom: 15px;
                /* Căn giữa icon khi thu gọn, căn trái khi mở rộng */
                justify-content: center;
                transition: all 0.4s ease;
                white-space: nowrap;
            }

            .sidebar-container:hover .sidebar-header {
                justify-content: flex-start;
            }

            .sidebar-header .logo-box {
                width: 45px;
                height: 45px;
                background: linear-gradient(135deg, #4caf50, #1b5e20);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: bold;
                font-size: 20px;
                color: white;
                box-shadow: 0 4px 10px rgba(76, 175, 80, 0.3);
                flex-shrink: 0;
            }

            .sidebar-header h2 {
                font-size: 1.15rem;
                font-weight: 700;
                color: #ffffff;
                letter-spacing: 0.5px;
                opacity: 0; /* Ẩn chữ đi khi thu gọn */
                transition: opacity 0.3s ease;
            }

            .sidebar-container:hover .sidebar-header h2 {
                opacity: 1; /* Hiện chữ khi mở rộng */
            }

            /* --- DANH SÁCH MENU --- */
            .sidebar-links {
                list-style: none;
                padding: 0;
                margin: 0;
                overflow-y: auto;
                overflow-x: hidden;
                height: calc(100vh - 120px);
            }

                .sidebar-links::-webkit-scrollbar {
                    width: 4px;
                }

                .sidebar-links::-webkit-scrollbar-thumb {
                    background-color: rgba(255,255,255,0.1);
                    border-radius: 4px;
                }

                /* Tiêu đề mục (Main Menu, Hệ thống...) */
                .sidebar-links h4 {
                    color: #8c9bb1;
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    letter-spacing: 1.5px;
                    margin-top: 25px;
                    margin-bottom: 10px;
                    display: flex;
                    align-items: center;
                    gap: 15px;
                    font-weight: 600;
                    white-space: nowrap;
                    opacity: 0; /* Ẩn chữ tiêu đề khi thu gọn */
                    transition: opacity 0.3s ease;
                    padding-left: 10px;
                }

            .sidebar-container:hover .sidebar-links h4 {
                opacity: 1; /* Hiện chữ tiêu đề khi mở rộng */
            }

            .menu-separator {
                flex: 1;
                height: 1px;
                background: rgba(255, 255, 255, 0.08);
                display: none; /* Mặc định ẩn đường kẻ */
            }

            .sidebar-container:hover .menu-separator {
                display: block; /* Chỉ hiện đường kẻ khi mở rộng */
            }

            /* Từng thẻ Menu <a> */
            .sidebar-links li {
                margin-bottom: 5px;
                padding: 0 10px; /* Thêm padding 2 bên để icon nằm giữa khối thu gọn */
            }

            .sidebar-container:hover .sidebar-links li {
                padding: 0; /* Khi mở rộng thì bỏ padding này đi để theo chuẩn CSS của thẻ <a> */
            }

            .sidebar-links a {
                display: flex;
                align-items: center;
                padding: 12px 0; /* Thu gọn thì bỏ padding 2 bên đi để icon ra giữa */
                justify-content: center; /* Căn giữa icon */
                color: #a0aec0;
                border-radius: 12px;
                text-decoration: none;
                font-size: 0.9rem;
                font-weight: 500;
                transition: all 0.3s ease;
                white-space: nowrap;
            }

            .sidebar-container:hover .sidebar-links a {
                padding: 12px 15px; /* Trả lại padding chuẩn khi mở rộng */
                justify-content: flex-start; /* Đẩy icon và chữ về bên trái */
            }

            .sidebar-links a i {
                font-size: 1.1rem;
                width: 20px;
                text-align: center;
                transition: transform 0.3s ease;
                flex-shrink: 0; /* Chống bị bóp méo icon */
            }

            .sidebar-links a span.link-text {
                opacity: 0; /* Ẩn chữ của Link khi thu gọn */
                transition: opacity 0.3s ease;
                margin-left: 14px;
            }

            .sidebar-container:hover .sidebar-links a span.link-text {
                opacity: 1; /* Hiện chữ của Link khi mở rộng */
            }

            /* Hiệu ứng Hover & Active (Đang chọn trang nào) */
            .sidebar-links a:hover,
            .sidebar-links a.active {
                background: rgba(255, 255, 255, 0.06);
                color: #ffffff;
            }

            .sidebar-container:hover .sidebar-links a:hover,
            .sidebar-container:hover .sidebar-links a.active {
                transform: translateX(5px);
            }

            .sidebar-links a:hover i,
            .sidebar-links a.active i {
                color: #4caf50;
                transform: scale(1.15);
            }

            /* Nút Xem trang chủ nổi bật */
            .sidebar-links a.btn-highlight {
                background: linear-gradient(135deg, #4caf50, #1b5e20);
                color: white;
                box-shadow: 0 4px 15px rgba(27, 94, 32, 0.2);
                margin-top: 15px;
            }

                .sidebar-links a.btn-highlight i {
                    color: white;
                }

            .sidebar-container:hover .sidebar-links a.btn-highlight:hover {
                transform: translateY(-3px) translateX(0);
                box-shadow: 0 6px 20px rgba(27, 94, 32, 0.4);
            }
    </style>
</head>

<body class="flex h-screen overflow-hidden">

    <!-- SIDEBAR BÊN TRÁI -->
    <!-- Dùng z-30 và absolute md:relative để sidebar nằm trùm lên nội dung (hoặc đẩy nội dung) -->
    <aside class="h-full z-30 py-4 flex flex-col absolute md:relative left-0 top-0">

        <div class="sidebar-container h-full">
            <div class="sidebar-header">
                <div class="logo-box">T</div>
                <h2>Trăng Sáng</h2>
            </div>

            <ul class="sidebar-links">
                <li>
                    <a href="@Url.Action("Index", "Admin")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")">
                        <i class="fas fa-tachometer-alt"></i> <span class="link-text">Bảng điều khiển</span>
                    </a>
                </li>

                <h4>
                    <span>Nội dung</span>
                    <div class="menu-separator"></div>
                </h4>

                <li>
                    <a href="@Url.Action("Index", "AdminTrangChu")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminTrangChu" ? "active" : "")">
                        <i class="fas fa-home"></i> <span class="link-text">Cấu hình Trang chủ</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminChuongTrinh")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminChuongTrinh" ? "active" : "")">
                        <i class="fas fa-calendar-alt"></i> <span class="link-text">Cấu hình Chương trình</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminGayQuy")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminGayQuy" ? "active" : "")">
                        <i class="fas fa-hand-holding-heart"></i> <span class="link-text">Cấu hình Đóng Góp</span>
                    </a>
                </li>
                <li>
                    <a href="/CuaHang/AdminSanPham" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminSanPham" ? "active" : "")">
                        <i class="fas fa-boxes"></i> <span class="link-text">Sản phẩm Gây Quỹ</span>
                    </a>
                </li>
                <li>
                    <a href="/CuaHang/AdminDonHang" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminDonHang" ? "active" : "")">
                        <i class="fas fa-receipt"></i> <span class="link-text">Đơn hàng Gây Quỹ</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminKyUc")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminKyUc" ? "active" : "")">
                        <i class="fas fa-images"></i> <span class="link-text">Cấu hình Ký ức</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminBanToChuc")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminBanToChuc" ? "active" : "")">
                        <i class="fas fa-sitemap"></i> <span class="link-text">Cấu hình Ban Tổ Chức</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "AdminTinTuc")" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminTinTuc" ? "active" : "")">
                        <i class="fas fa-newspaper"></i> <span class="link-text">Cấu hình Tin tức</span>
                    </a>
                </li>

                <h4>
                    <span>Tương tác</span>
                    <div class="menu-separator"></div>
                </h4>
                <li>
                    <a href="#">
                        <i class="fas fa-users"></i> <span class="link-text">Đăng ký TNV</span>
                    </a>
                </li>

                <h4>
                    <span>Hệ thống</span>
                    <div class="menu-separator"></div>
                </h4>
                <li>
                    <a href="@Url.Action("Index", "Home")" target="_blank" class="btn-highlight">
                        <i class="fas fa-external-link-alt"></i> <span class="link-text">Xem trang ngoài</span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>

    <!-- NỘI DUNG CHÍNH BÊN PHẢI -->
    <!-- Thêm padding-left cho phiên bản mobile/tablet để không bị sidebar che mất -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden relative md:pl-0 pl-[100px]">

        <!-- TOPBAR -->
        <header class="h-20 flex items-center justify-between px-4 md:px-8 z-10 shrink-0 mt-4">
            <div class="flex items-center gap-3 text-gray-800 font-extrabold text-xl md:text-2xl tracking-tight">
                @ViewData["Title"]
            </div>

            <div class="flex items-center gap-5">
                <!-- Info user -->
                <div class="hidden sm:flex items-center gap-3 bg-white px-4 py-2 rounded-2xl shadow-sm border border-gray-100">
                    <div class="h-8 w-8 rounded-xl bg-[#161a2d] text-white flex items-center justify-center font-bold text-sm shadow-md">
                        A
                    </div>
                    <div class="flex flex-col">
                        <span class="text-sm font-bold text-gray-800 leading-none">Admin Hệ thống</span>
                        <span class="text-[10px] text-gray-500 font-medium mt-1">Quản trị viên</span>
                    </div>
                </div>
                <!-- Logout -->
                <a href="#" title="Đăng xuất" class="w-10 h-10 rounded-full bg-white text-gray-400 hover:text-red-500 hover:bg-red-50 flex items-center justify-center shadow-sm border border-gray-100 transition-all">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
        </header>

        <!-- KHI RENDER CÁC VIEW CON SẼ HIỂN THỊ TẠI ĐÂY -->
        <main class="flex-1 overflow-y-auto p-4 md:p-8 pt-4">
            @RenderBody()
        </main>
    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>