    <!-- JAVASCRIPT ĐIỀU KHIỂN CHUYỂN ĐỔI THEME VÀ NAVIGATION -->
    <script>
        function toggleThemeMode() {
            // Ngăn chặn tuyệt đối nếu vô tình gọi trên trang Cửa Hàng
            if (window.location.pathname.toLowerCase().indexOf('/cuahang') !== -1) {
                return;
            }

            var isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.add('light');
                localStorage.setItem('site_theme', 'light');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                document.documentElement.classList.remove('light');
                localStorage.setItem('site_theme', 'dark');
                localStorage.setItem('theme', 'dark');
            }

            // Đồng bộ màu inline nếu có phần tử cũ
            syncInlineColorsForTheme(!isDark);

            // Phát sự kiện để các component khác (biểu đồ, Swiper) có thể re-render
            window.dispatchEvent(new CustomEvent('themeChanged', { detail: { isDark: !isDark } }));
        }

        // Tương thích ngược với bất kỳ lệnh gọi toggleTheme nào
        window.toggleTheme = toggleThemeMode;
        window.toggleThemeMode = toggleThemeMode;

        function syncInlineColorsForTheme(isDark) {
            const elements = document.querySelectorAll('main [style*="color"]');
            elements.forEach(el => {
                if (el.closest('.keep-theme') || el.style.backgroundColor || el.style.background || el.classList.contains('keep-color')) { return; }
                if (!el.dataset.origColor && el.style.color) { el.dataset.origColor = el.style.color; }
                if (isDark) {
                    const tag = el.tagName.toLowerCase();
                    if (tag === 'h1' || tag === 'h2' || tag === 'h3' || tag === 'h4') el.style.setProperty('color', '#86efac', 'important');
                    else el.style.setProperty('color', '#f1f5f9', 'important');
                } else {
                    if (el.dataset.origColor) el.style.color = el.dataset.origColor;
                    else el.style.removeProperty('color');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            /* 1. XỬ LÝ THANH LIQUID BOTTOM NAV TRÊN MOBILE */
            const listItems = document.querySelectorAll('.navigation .list');
            const indicator = document.querySelector('.navigation .indicator');

            function setActiveBottomNav() {
                let currentPath = window.location.pathname.toLowerCase();
                if (currentPath === '/' || currentPath === '') currentPath = '/home/index';

                let itemWidth = 100 / listItems.length;

                listItems.forEach((item, index) => {
                    item.classList.remove('active');
                    let itemPath = item.getAttribute('data-url');

                    // So sánh đường dẫn
                    if (currentPath.includes(itemPath) || (itemPath === '/home/index' && currentPath === '/')) {
                        item.classList.add('active');
                        let centerPosition = (index * itemWidth) + (itemWidth / 2);
                        if (indicator) {
                            indicator.style.left = `calc(${centerPosition}%)`;
                        }
                    }
                });
            }
            if (listItems.length > 0 && indicator) {
                setActiveBottomNav();
            }

            /* 2. ĐỒNG BỘ THEME BAN ĐẦU */
            try {
                if (window.location.pathname.toLowerCase().indexOf('/cuahang') !== -1) {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.classList.add('light');
                } else {
                    const isInitialDark = document.documentElement.classList.contains('dark');
                    syncInlineColorsForTheme(isInitialDark);
                }
            } catch (e) { }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
