@model WEB_TinhNguyen.MoHinh.CauHinhTinTucVM
@{
    ViewData["Title"] = "Cấu hình Bản Tin - " + Model.TenChienDich;
    Layout = "~/GiaoDien/Shared/_AdminLayout.cshtml";
}

<div class="max-w-7xl mx-auto my-8 px-4 sm:px-6 lg:px-8">
    <!-- HEADER -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-200 pb-5">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
                <a href="@Url.Action("Index", "AdminTinTuc")" class="hover:text-emerald-600 font-medium">← Quay lại danh sách</a>
                <span>/</span>
                <span>Mùa @Model.NamChienDich</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900">
                Quản lý Trang Bản Tin - <span class="text-emerald-600">@Model.TenChienDich</span>
            </h2>
        </div>
        <div class="flex items-center gap-3">
            <a href="@Url.Action("TinTuc", "Home", new { year = Model.NamChienDich })" target="_blank"
               class="inline-flex items-center px-4 py-2.5 border border-gray-300 text-sm font-semibold rounded-xl text-gray-700 bg-white hover:bg-gray-50 shadow-sm transition">
                👁️ Xem thử trang thật
            </a>
            <button type="submit" form="tinTucForm"
                    class="inline-flex items-center px-6 py-2.5 text-sm font-bold rounded-xl text-white bg-emerald-600 hover:bg-emerald-700 shadow-md transition">
                💾 Lưu Toàn Bộ Cấu Hình
            </button>
        </div>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="tinTucForm">
        <input type="hidden" asp-for="IDCauHinhTT" />
        <input type="hidden" asp-for="IDChienDich" />
        <input type="hidden" asp-for="TenChienDich" />
        <input type="hidden" asp-for="NamChienDich" />

        <!-- TABS NAVIGATION -->
        <div class="bg-white rounded-t-2xl border-x border-t border-gray-200 px-3 pt-3">
            <div class="flex space-x-2 overflow-x-auto pb-2">
                <button type="button" class="tab-btn active shrink-0 px-5 py-2.5 text-sm font-bold rounded-xl text-emerald-700 bg-emerald-50 transition" data-target="tabPosts">
                    📰 1. Danh Sách Bài Viết & Nội Dung Popup (@Model.BaiViets.Count bài)
                </button>
                <button type="button" class="tab-btn shrink-0 px-5 py-2.5 text-sm font-bold rounded-xl text-gray-500 hover:bg-gray-50 transition" data-target="tabHero">
                    🌟 2. Giao Diện Mở Đầu (Hero), Font Chữ & Màu Nền
                </button>
            </div>
        </div>

        <!-- CONTENT AREA -->
        <div class="bg-gray-50 rounded-b-2xl border border-gray-200 p-6 sm:p-8 shadow-sm">

            <!-- ========================================================== -->
            <!-- TAB 1: DANH SÁCH BÀI VIẾT & NỘI DUNG POPUP                 -->
            <!-- ========================================================== -->
            <div id="tabPosts" class="tab-content block space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900">Danh sách các Bài viết trên trang Bản tin</h3>
                        <p class="text-xs text-gray-500">Khi người dùng bấm vào thẻ bài viết hoặc chữ "Đọc tiếp", Popup sẽ hiển thị toàn bộ nội dung chi tiết và ảnh đính kèm bên dưới.</p>
                    </div>
                    <button type="button" onclick="addNewsPost()"
                            class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2.5 rounded-xl shadow-sm transition shrink-0">
                        + Thêm Bài Viết Mới
                    </button>
                </div>

                <div id="repeaterPosts" class="space-y-8">
                    @for (int i = 0; i < Model.BaiViets.Count; i++)
                    {
                        <div class="bg-white border-2 border-emerald-100 rounded-2xl p-6 shadow-sm relative r-item space-y-5">
                            <div class="flex items-center justify-between border-b pb-3">
                                <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-xs uppercase">
                                    Bài viết #@(i + 1)
                                </span>
                                <button type="button" class="bg-red-50 text-red-600 hover:bg-red-600 hover:text-white px-3.5 py-1.5 rounded-lg text-xs font-bold transition btn-remove">
                                    ✕ Xóa bài viết này
                                </button>
                            </div>

                            <input type="hidden" asp-for="BaiViets[i].LinkAnhDaiDienCu" />
                            <input type="hidden" asp-for="BaiViets[i].LinkAnhTrongBaiCu" />

                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                                <!-- CỘT TRÁI (5/12): THÔNG TIN THẺ BÊN NGOÀI -->
                                <div class="lg:col-span-5 space-y-4">
                                    <div>
                                        <label class="block text-xs font-bold uppercase text-gray-600 mb-1">Tiêu đề bài viết</label>
                                        <input asp-for="BaiViets[i].TieuDe" class="w-full border rounded-xl p-2.5 text-sm font-bold text-gray-900" placeholder="Nhập tiêu đề..." />
                                    </div>

                                    <div class="bg-gray-50 p-3 rounded-xl border">
                                        <div>
                                            <label class="block text-[11px] font-bold text-gray-600 mb-1">Cỡ chữ Thẻ</label>
                                            <input asp-for="BaiViets[i].CoChuTieuDe" class="w-full border rounded-lg p-1.5 text-sm text-center bg-white" placeholder="18px" />
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-bold text-gray-600 mb-1">Nhãn phân loại (Tag)</label>
                                        <input asp-for="BaiViets[i].ThePhanLoai" class="w-full border rounded-lg p-2 text-sm font-semibold" placeholder="VD: [THƯ NGỎ 2026]" />
                                    </div>

                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="block text-xs font-bold text-gray-600 mb-1">❤️ Lượt thích</label>
                                            <input type="number" asp-for="BaiViets[i].LuotThich" class="w-full border rounded-lg p-2 text-sm font-bold text-rose-600" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-gray-600 mb-1">📅 Ngày đăng</label>
                                            <input type="date" asp-for="BaiViets[i].NgayDang" class="w-full border rounded-lg p-2 text-sm" />
                                        </div>
                                    </div>

                                    <div>
                                        <label class="block text-xs font-bold text-gray-600 mb-1">Đoạn trích dẫn ngắn (Hiện bên ngoài Card)</label>
                                        <textarea asp-for="BaiViets[i].TrichDan" rows="3" class="w-full border rounded-xl p-2.5 text-sm"></textarea>
                                    </div>

                                    <!-- Upload Ảnh bìa ngoài Card -->
                                    <div class="bg-gray-50 p-3.5 rounded-xl border space-y-2">
                                        <label class="block text-xs font-bold text-gray-700">🖼️ Ảnh bìa hiển thị ngoài Thẻ (Tỷ lệ 16:10)</label>
                                        @if (!string.IsNullOrEmpty(Model.BaiViets[i].LinkAnhDaiDienCu))
                                        {
                                            <img src="@Model.BaiViets[i].LinkAnhDaiDienCu" class="h-28 w-full object-cover rounded-lg border shadow-sm" />
                                        }
                                        <input type="file" name="BaiViets[@i].FileAnhDaiDien" accept="image/*" class="w-full text-xs border bg-white p-1.5 rounded file-upload" />
                                    </div>
                                </div>

                                <!-- CỘT PHẢI (7/12): NỘI DUNG CHI TIẾT TRONG POPUP -->
                                <div class="lg:col-span-7 space-y-4 lg:border-l lg:pl-6">
                                    <div>
                                        <label class="block text-xs font-bold uppercase text-sky-700 mb-2">
                                            📖 Nội dung chi tiết hiển thị trong Popup khi bấm "Đọc tiếp"
                                        </label>
                                        <textarea asp-for="BaiViets[i].NoiDungChiTiet" rows="12" class="w-full border rounded-xl p-3 text-sm tinymce-editor"></textarea>
                                    </div>

                                    <!-- Upload Ảnh Banner đính kèm dưới nội dung Popup (Giống ảnh mẫu VKIT) -->
                                    <div class="bg-sky-50/60 p-4 rounded-xl border border-sky-100 space-y-2">
                                        <label class="block text-xs font-bold text-sky-900">
                                            🌄 Ảnh Poster / Banner lớn nằm trong Popup (Hiển thị bo góc đẹp mắt ở cuối bài viết như ảnh mẫu)
                                        </label>
                                        @if (!string.IsNullOrEmpty(Model.BaiViets[i].LinkAnhTrongBaiCu))
                                        {
                                            <img src="@Model.BaiViets[i].LinkAnhTrongBaiCu" class="h-36 object-contain rounded-xl border bg-white p-1 shadow-sm" />
                                        }
                                        <input type="file" name="BaiViets[@i].FileAnhTrongBai" accept="image/*" class="w-full text-xs border bg-white p-1.5 rounded file-upload" />
                                    </div>

                                    <div>
                                        <label class="block text-xs font-semibold text-gray-500 mb-1">Link bài viết gốc trên Fanpage (Tùy chọn)</label>
                                        <input asp-for="BaiViets[i].LinkBaiVietGoc" class="w-full border rounded-lg p-2 text-xs text-blue-600" placeholder="https://www.facebook.com/..." />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ========================================================== -->
            <!-- TAB 2: GIAO DIỆN HERO, FONT CHỮ & MÀU NỀN TOÀN TRANG       -->
            <!-- ========================================================== -->
            <div id="tabHero" class="tab-content hidden space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Khối Hero Banner -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4">
                        <h3 class="text-lg font-bold text-gray-900 border-b pb-3">Nội dung Khu vực Mở đầu (Hero)</h3>

                        <div>
                            <label class="block text-xs font-bold text-gray-600 mb-1">Nhãn nhỏ (Badge)</label>
                            <input type="text" asp-for="Hero_Nhan" class="w-full border rounded-lg p-2 text-sm font-bold" />
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div class="sm:col-span-2">
                                <label class="block text-xs font-bold text-gray-600 mb-1">Tiêu đề chính (H1)</label>
                                <input type="text" asp-for="Hero_TieuDe" class="w-full border rounded-lg p-2 font-bold" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-600 mb-1">Cỡ chữ (VD: 64px)</label>
                                <input type="text" asp-for="Hero_CoChuTieuDe" class="w-full border rounded-lg p-2" />
                            </div>
                        </div>

                        <div>
                            <label class="text-xs font-bold text-gray-600 block mb-1">Đoạn văn mô tả</label>
                            <textarea asp-for="Hero_MoTa" rows="3" class="w-full border rounded-xl p-2.5 text-sm"></textarea>
                        </div>
                    </div>

                    <!-- Khối Font chữ -->
                    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-5">
                        <h3 class="text-lg font-bold text-gray-900 border-b pb-3">Font chữ toàn trang</h3>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-gray-600 mb-1">Font Tiêu đề lớn (Google Fonts)</label>
                                <input type="text" asp-for="FontTieuDe" class="w-full border rounded-lg p-2 text-sm" placeholder="VD: Dancing Script" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-gray-600 mb-1">Font Nội dung & Bài viết</label>
                                <input type="text" asp-for="FontNoiDung" class="w-full border rounded-lg p-2 text-sm" placeholder="VD: Be Vietnam Pro" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<!-- ========================================== -->
<!-- TEMPLATE ẨN ĐỂ THÊM BÀI VIẾT MỚI (JS)      -->
<!-- ========================================== -->
<div id="templatePost" class="hidden">
    <div class="bg-white border-2 border-emerald-100 rounded-2xl p-6 shadow-sm relative r-item space-y-5">
        <div class="flex items-center justify-between border-b pb-3">
            <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 font-extrabold text-xs uppercase">Bài viết mới</span>
            <button type="button" class="bg-red-50 text-red-600 hover:bg-red-600 hover:text-white px-3.5 py-1.5 rounded-lg text-xs font-bold transition btn-remove">✕ Xóa bài viết này</button>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <div class="lg:col-span-5 space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase text-gray-600 mb-1">Tiêu đề bài viết</label>
                    <input name="BaiViets[INDEX].TieuDe" class="w-full border rounded-xl p-2.5 text-sm font-bold text-gray-900" placeholder="Nhập tiêu đề..." />
                </div>
                <div class="bg-gray-50 p-3 rounded-xl border">
                    <div>
                        <label class="block text-[11px] font-bold text-gray-600 mb-1">Cỡ chữ Thẻ</label>
                        <input name="BaiViets[INDEX].CoChuTieuDe" value="18px" class="w-full border rounded-lg p-1.5 text-sm text-center bg-white" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">Nhãn phân loại (Tag)</label>
                    <input name="BaiViets[INDEX].ThePhanLoai" value="THÔNG BÁO 2026" class="w-full border rounded-lg p-2 text-sm font-semibold" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div><label class="block text-xs font-bold text-gray-600 mb-1">❤️ Lượt thích</label><input type="number" name="BaiViets[INDEX].LuotThich" value="10" class="w-full border rounded-lg p-2 text-sm font-bold text-rose-600" /></div>
                    <div><label class="block text-xs font-bold text-gray-600 mb-1">📅 Ngày đăng</label><input type="date" name="BaiViets[INDEX].NgayDang" value="@DateTime.Now.ToString("yyyy-MM-dd")" class="w-full border rounded-lg p-2 text-sm" /></div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">Đoạn trích dẫn ngắn (Hiện ngoài Card)</label>
                    <textarea name="BaiViets[INDEX].TrichDan" rows="3" class="w-full border rounded-xl p-2.5 text-sm"></textarea>
                </div>
                <div class="bg-gray-50 p-3.5 rounded-xl border space-y-2">
                    <label class="block text-xs font-bold text-gray-700">🖼️ Ảnh bìa hiển thị ngoài Thẻ</label>
                    <input type="file" name="BaiViets[INDEX].FileAnhDaiDien" accept="image/*" class="w-full text-xs border bg-white p-1.5 rounded file-upload" />
                </div>
            </div>

            <div class="lg:col-span-7 space-y-4 lg:border-l lg:pl-6">
                <div>
                    <label class="block text-xs font-bold uppercase text-sky-700 mb-2">📖 Nội dung chi tiết hiển thị trong Popup khi bấm "Đọc tiếp"</label>
                    <textarea name="BaiViets[INDEX].NoiDungChiTiet" rows="12" class="w-full border rounded-xl p-3 text-sm raw-tinymce"></textarea>
                </div>
                <div class="bg-sky-50/60 p-4 rounded-xl border border-sky-100 space-y-2">
                    <label class="block text-xs font-bold text-sky-900">🌄 Ảnh Poster / Banner lớn nằm trong Popup (Cuối bài viết)</label>
                    <input type="file" name="BaiViets[INDEX].FileAnhTrongBai" accept="image/*" class="w-full text-xs border bg-white p-1.5 rounded file-upload" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Link bài viết gốc (Tùy chọn)</label>
                    <input name="BaiViets[INDEX].LinkBaiVietGoc" class="w-full border rounded-lg p-2 text-xs" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SỬ DỤNG LINK CDN OPEN SOURCE NÀY ĐỂ KHÔNG BAO GIỜ BỊ KHÓA API KEY -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/6.8.2/tinymce.min.js" referrerpolicy="origin"></script>

    <script>
        // 1. HÀM KHỞI TẠO TINYMCE
        function initTinyMCE(selector) {
            try {
                tinymce.init({
                    selector: selector,
                    plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
                    toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline forecolor backcolor | alignleft aligncenter alignright | bullist numlist | image link emoticons | removeformat',
                    menubar: false,
                    height: 320,
                    promotion: false, // Ẩn nút Upgrade
                    branding: false   // Ẩn chữ Powered by TinyMCE
                });
            } catch (e) { console.warn(e); }
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Khởi tạo Editor cho các bài viết đã có sẵn khi vừa load trang
            setTimeout(() => { initTinyMCE('.tinymce-editor'); }, 250);

            // Chuyển đổi Tabs (Danh sách bài viết & Hero)
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tab-btn').forEach(b => {
                        b.classList.remove('active', 'text-emerald-700', 'bg-emerald-50');
                        b.classList.add('text-gray-500');
                    });
                    document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));

                    btn.classList.remove('text-gray-500');
                    btn.classList.add('active', 'text-emerald-700', 'bg-emerald-50');
                    document.getElementById(btn.dataset.target).classList.remove('hidden');
                });
            });

            // Đồng bộ dữ liệu TinyMCE trước khi bấm LƯU
            const tinTucForm = document.getElementById('tinTucForm');
            if (tinTucForm) {
                tinTucForm.addEventListener('submit', function() {
                    if (typeof tinymce !== 'undefined') {
                        tinymce.triggerSave();
                    }
                });
            }
        });

        // 2. THÊM BÀI VIẾT MỚI VÀO REPEATER
        window.addNewsPost = function() {
            const container = document.getElementById('repeaterPosts');
            const template = document.getElementById('templatePost').innerHTML;
            container.insertAdjacentHTML('afterbegin', template); // Thêm lên đầu danh sách
            reindexElements(container);

            // Kích hoạt TinyMCE cho bài viết vừa thêm
            const firstItem = container.firstElementChild;
            const rawTextarea = firstItem.querySelector('.raw-tinymce');
            if (rawTextarea) {
                const uniqueId = 'editor-' + Date.now();
                rawTextarea.id = uniqueId;
                rawTextarea.classList.remove('raw-tinymce');
                initTinyMCE('#' + uniqueId);
            }
        };

        // 3. ĐÁNH LẠI CHỈ MỤC [0], [1], [2] ĐỂ C# NHẬN DỮ LIỆU
        function reindexElements(container) {
            const items = container.querySelectorAll('.r-item');
            items.forEach((item, index) => {
                item.querySelectorAll('input, select, textarea').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/\[\d+\]|[INDEX]/g, `[${index}]`));
                    }
                });
            });
        }

        // 4. XÓA BÀI VIẾT
        document.addEventListener('click', function(e) {
            const removeBtn = e.target.closest('.btn-remove');
            if (removeBtn) {
                e.preventDefault();
                if (confirm('Bạn có chắc muốn xóa bài viết này?')) {
                    const item = removeBtn.closest('.r-item');
                    const container = item.closest('#repeaterPosts');
                    item.remove();
                    reindexElements(container);
                }
            }
        });

        // 5. CHẶN UPLOAD ẢNH QUÁ 2MB
        document.addEventListener('change', function(e) {
            if (e.target.classList.contains('file-upload')) {
                const file = e.target.files[0];
                if (file && file.size > 2 * 1024 * 1024) {
                    alert('File ảnh quá lớn! Vui lòng chọn file dưới 2MB.');
                    e.target.value = '';
                }
            }
        });
    </script>
}
}