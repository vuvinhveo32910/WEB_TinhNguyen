@using Microsoft.EntityFrameworkCore
@using WEB_TinhNguyen.DuLieu
@using WEB_TinhNguyen.Areas.CuaHang.Models
@using WEB_TinhNguyen.Areas.CuaHang.Helpers
@inject ApplicationDbContext _context
@{
    var sessionCart = Context.Session.Get<List<CartItem>>("GioHangGayQuy");
    int cartCount = sessionCart?.Sum(i => i.SoLuong) ?? 0;

    var activeConfig = _context.CauHinhTrangChus
        .Include(c => c.ChienDich)
        .Where(c => c.ChienDich.TrangThaiHoatDong == true)
        .FirstOrDefault();

    string? logoImg = activeConfig?.LinkAnhBia;
    string? textTop = activeConfig?.TieuDePhu;
    string? textBot = activeConfig?.TieuDeChinh;

    int currentYear = activeConfig?.ChienDich?.Nam ?? DateTime.Now.Year;
}

<!DOCTYPE html>
<html lang="vi" class="light scroll-smooth">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <meta name="theme-color" content="#15803d">
    <title>@ViewData["Title"] - Cửa Hàng Gây Quỹ Tình Nguyện</title>

    @if (!string.IsNullOrEmpty(logoImg))
    {
        <link rel="shortcut icon" href="@logoImg">
    }

    <!-- FONT CHỮ VÀ ICON FONT AWESOME -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <!-- CSS TĨNH & TAILWIND -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        'night': '#0c1712',
                        'night-2': '#14241b'
                    }
                }
            }
        }
    </script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- CÔ LẬP CỬA HÀNG: CƯỠNG CHẾ LIGHT MODE TUYỆT ĐỐI -->
    <script>
        (function() {
            try {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.add('light');
            } catch (e) {
                console.error('Lỗi thiết lập theme cửa hàng:', e);
            }
        })();
    </script>

    <style>
        body.cuahang-body {
            font-family: 'Be Vietnam Pro', system-ui, sans-serif;
            background-color: #f8fafc !important;
            color: #0f172a !important;
        }

        /* Mobile bottom nav */
        .navigation {
            position: fixed;
            bottom: 15px;
            left: 50%;
            transform: translateX(-50%);
            width: 96%;
            height: 70px;
            background: #222327;
            border-radius: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .navigation ul {
            display: flex;
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            position: relative;
        }

        .navigation ul li {
            position: relative;
            list-style: none;
            flex: 1;
            height: 100%;
            z-index: 2;
        }

        .navigation ul li a {
            position: relative;
            display: block;
            width: 100%;
            height: 100%;
            text-align: center;
            -webkit-tap-highlight-color: transparent;
        }

        .navigation ul li a .icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 1.4rem;
            color: rgba(255, 255, 255, 0.5);
            transition: 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            z-index: 10;
        }

        .navigation ul li.active a .icon {
            top: 0px;
            color: #222327;
            font-size: 1.5rem;
        }

        .navigation ul li a .text {
            position: absolute;
            bottom: -20px;
            left: 50%;
            transform: translateX(-50%);
            color: #ffffff;
            font-weight: 600;
            font-size: 10px;
            letter-spacing: 0.05em;
            transition: 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            opacity: 0;
            pointer-events: none;
            white-space: nowrap;
        }

        .navigation ul li.active a .text {
            opacity: 1;
            bottom: 12px;
        }

        .navigation .indicator {
            position: absolute;
            top: -36px;
            width: 60px;
            height: 60px;
            background: #ffffff;
            border-radius: 50%;
            border: 6px solid #222327;
            transition: 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            transform: translateX(-50%);
            box-sizing: content-box;
            z-index: 1;
        }

        @@media (max-width: 1023px) {
            body.cuahang-body {
                padding-bottom: 100px;
            }
        }
    </style>
</head>

<body class="light bg-slate-50 text-slate-900 cuahang-body antialiased relative selection:bg-emerald-500 selection:text-white">

    <!-- Header Cửa hàng -->
    <header id="main-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300 bg-white/95 backdrop-blur-md shadow-xs py-2 border-b border-slate-200">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-5">
            <a href="/" class="flex min-w-0 items-center gap-2 sm:gap-2.5">
                @if (!string.IsNullOrEmpty(logoImg))
                {
                    <span class="relative flex h-11 w-11 items-center justify-center overflow-hidden">
                        <img alt="Logo" width="44" height="44" class="object-contain" src="@logoImg">
                    </span>
                }
                <span class="min-w-0 leading-tight">
                    <span class="block text-[10px] font-bold uppercase tracking-wider text-emerald-700 sm:text-[11px]">CỬA HÀNG GÂY QUỸ</span>
                    <span class="block truncate text-lg font-black text-slate-900 sm:text-2xl pt-0.5">Trăng Sáng Langbiang</span>
                </span>
            </a>

            <!-- Menu Desktop -->
            <nav class="hidden md:flex items-center gap-1 lg:flex pr-4">
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-emerald-700 transition" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a class="rounded-full px-3.5 py-2 text-sm font-semibold bg-emerald-15 text-emerald-800 transition" asp-area="CuaHang" asp-controller="CuaHang" asp-action="Index">Cửa hàng Gây quỹ</a>
                
                <a asp-area="CuaHang" asp-controller="GioHang" asp-action="Index"
                   class="relative inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-700 transition shadow-xs"
                   title="Xem giỏ quà gây quỹ">
                    <i class="fas fa-shopping-basket"></i>
                    <span>Giỏ quà</span>
                    <span id="cartCountBadge" class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-[11px] font-black text-white bg-rose-500 rounded-full">
                        @cartCount
                    </span>
                </a>

                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-emerald-700 transition" asp-area="" asp-controller="Home" asp-action="ChuongTrinh">Chương trình</a>
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-emerald-700 transition" asp-area="" asp-controller="Home" asp-action="GayQuy">Đóng góp</a>
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-emerald-700 transition" asp-area="" asp-controller="Home" asp-action="BanToChuc">Ban tổ chức</a>
                <a class="rounded-full px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-emerald-700 transition" asp-area="" asp-controller="Home" asp-action="TinTuc">Tin tức</a>

                <div class="relative group">
                    <button type="button" class="flex items-center gap-1.5 rounded-full px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-emerald-700 transition">
                        Ký ức <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
                    </button>
                    <div class="absolute right-0 top-full mt-1 w-36 rounded-xl bg-white p-1.5 shadow-lg ring-1 ring-black/5 opacity-0 invisible translate-y-2 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50">
                        @{
                            var cacNam = _context.ChienDichs.Select(c => c.Nam).Distinct().OrderBy(n => n).ToList();
                            foreach (var nam in cacNam)
                            {
                                <a href="@Url.Action("KyUc", "Home", new { area = "", year = nam })" class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 transition">Mùa @nam</a>
                            }
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    <!-- Nội dung chính được cô lập hoàn toàn -->
    <main class="min-h-screen pt-[60px] md:pt-[72px] pb-16 cuahang-isolated-scope">
        @RenderBody()
    </main>

    <!-- FOOTER CỬA HÀNG (MÀU XANH TRUYỀN THỐNG) -->
    <footer class="relative mt-24 bg-[#143220] text-white">
        <div class="absolute top-0 left-0 w-full overflow-hidden leading-none transform -translate-y-full">
            <svg viewBox="0 0 1440 100" preserveAspectRatio="none" class="block w-full h-[60px] md:h-[90px]">
                <path d="M0,32L60,42.7C120,53,240,75,360,74.7C480,75,600,53,720,48C840,43,960,53,1080,58.7C1200,64,1320,64,1380,64L1440,64L1440,100L1380,100C1320,100,1200,100,1080,100C960,100,840,100,720,100C600,100,480,100,360,100C240,100,120,100,60,100L0,100Z" class="fill-[#1e4b30]"></path>
                <path d="M0,64L60,58.7C120,53,240,43,360,48C480,53,600,75,720,80C840,85,960,75,1080,64C1200,53,1320,43,1380,37.3L1440,32L1440,100L1380,100C1320,100,1200,100,1080,100C960,100,840,100,720,100C600,100,480,100,360,100C240,100,120,100,60,100L0,100Z" class="fill-[#143220]"></path>
            </svg>
        </div>

        <div class="mx-auto max-w-7xl px-6 pb-8 pt-10 md:pt-14 relative z-10">
            <div class="grid gap-12 md:grid-cols-12">
                <div class="md:col-span-5 lg:col-span-4">
                    <a href="/" class="inline-flex items-center gap-3 mb-6 bg-white/5 hover:bg-white/10 py-2.5 px-3.5 rounded-2xl border border-white/10 backdrop-blur-sm transition shadow-sm">
                        @if (!string.IsNullOrEmpty(logoImg))
                        {
                            <div class="bg-white p-1.5 rounded-xl shadow-inner shrink-0">
                                <img alt="Logo Footer" loading="lazy" class="h-10 w-10 sm:h-11 sm:w-11 object-contain" src="@logoImg">
                            </div>
                        }
                        <div class="leading-tight">
                            <span class="block text-[10px] font-extrabold uppercase tracking-widest text-emerald-400 mb-0.5">DỰ ÁN TÌNH NGUYỆN</span>
                            <span class="block font-black text-white text-lg sm:text-xl leading-none">Trăng Sáng Langbiang</span>
                        </div>
                    </a>
                    <p class="text-white/70 text-sm leading-relaxed mb-6 font-medium pr-4">
                        100% lợi nhuận từ các sản phẩm được chuyển vào quỹ hoạt động thiện nguyện mang niềm vui và tri thức đến các em nhỏ vùng cao.
                    </p>
                    <div class="flex items-center gap-3">
                        <a href="https://www.facebook.com/profile.php?id=61580211752903" target="_blank" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 hover:bg-blue-600 hover:border-blue-600 hover:text-white transition text-white/80 border border-white/20 shadow-sm"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 hover:bg-red-600 hover:border-red-600 hover:text-white transition text-white/80 border border-white/20 shadow-sm"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 hover:bg-emerald-500 hover:border-emerald-500 hover:text-white transition text-white/80 border border-white/20 shadow-sm"><i class="fas fa-envelope"></i></a>
                    </div>
                </div>
                <div class="md:col-span-3 lg:col-span-4 md:pl-8">
                    <h3 class="text-sm font-extrabold uppercase tracking-widest text-emerald-400 mb-6">Khám phá</h3>
                    <ul class="space-y-4 text-white/80 font-medium text-sm hidden md:block">
                        <li><a href="/CuaHang" class="group flex items-center gap-2.5 hover:text-white transition"><i class="fas fa-chevron-right text-[10px] text-emerald-500 group-hover:translate-x-1 transition-transform"></i> Cửa hàng gây quỹ</a></li>
                        <li><a href="/Home/ChuongTrinh" class="group flex items-center gap-2.5 hover:text-white transition"><i class="fas fa-chevron-right text-[10px] text-emerald-500 group-hover:translate-x-1 transition-transform"></i> Chương trình</a></li>
                        <li><a href="/Home/BanToChuc" class="group flex items-center gap-2.5 hover:text-white transition"><i class="fas fa-chevron-right text-[10px] text-emerald-500 group-hover:translate-x-1 transition-transform"></i> Ban tổ chức</a></li>
                        <li><a href="/Home/TinTuc" class="group flex items-center gap-2.5 hover:text-white transition"><i class="fas fa-chevron-right text-[10px] text-emerald-500 group-hover:translate-x-1 transition-transform"></i> Tin tức dự án</a></li>
                        <li><a href="/Home/GayQuy" class="group flex items-center gap-2.5 hover:text-white transition"><i class="fas fa-chevron-right text-[10px] text-emerald-500 group-hover:translate-x-1 transition-transform"></i> Đóng góp & Tài trợ</a></li>
                    </ul>
                </div>
                <div class="md:col-span-4 lg:col-span-4">
                    <h3 class="text-sm font-extrabold uppercase tracking-widest text-emerald-400 mb-6">Liên hệ</h3>
                    <ul class="space-y-4 text-white/80 text-sm font-medium">
                        <li class="flex items-start gap-3"><i class="fas fa-map-marker-alt mt-1 text-emerald-500 text-lg w-5 text-center"></i><span class="leading-relaxed">Viện Công nghệ Việt - Hàn (VKIT), HUTECH</span></li>
                        <li class="flex items-center gap-3"><i class="fas fa-envelope text-emerald-500 text-lg w-5 text-center"></i><a href="mailto:vkit.hutech@gmail.com" class="hover:text-white transition">vkit.hutech@gmail.com</a></li>
                        <li class="flex items-center gap-3"><i class="fas fa-phone-alt text-emerald-500 text-lg w-5 text-center"></i><a href="tel:0123456789" class="hover:text-white transition">0123 456 789</a></li>
                    </ul>
                </div>
            </div>
            <div class="mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
                <p class="text-xs text-white/50 font-medium text-center md:text-left">&copy; @DateTime.Now.Year - Trăng Sáng Langbiang.</p>
            </div>
        </div>
    </footer>

    <!-- THANH LIQUID BOTTOM NAVIGATION MOBILE -->
    <div class="navigation fixed bottom-[15px] md:hidden lg:hidden">
        <ul>
            <li class="list" data-url="/home/index">
                <a href="/">
                    <span class="icon"><i class="fas fa-home"></i></span>
                    <span class="text">Trang chủ</span>
                </a>
            </li>
            <li class="list active" data-url="/cuahang">
                <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="Index">
                    <span class="icon"><i class="fas fa-store"></i></span>
                    <span class="text">Cửa hàng</span>
                </a>
            </li>
            <li class="list" data-url="/home/chuongtrinh">
                <a href="/Home/ChuongTrinh">
                    <span class="icon"><i class="fas fa-calendar-alt"></i></span>
                    <span class="text">Sự kiện</span>
                </a>
            </li>
            <li class="list" data-url="/home/kyuc">
                <a href="/Home/KyUc?year=@currentYear">
                    <span class="icon"><i class="fas fa-history"></i></span>
                    <span class="text">Ký ức</span>
                </a>
            </li>
            <li class="list" data-url="/home/gayquy">
                <a href="/Home/GayQuy">
                    <span class="icon"><i class="fas fa-heart"></i></span>
                    <span class="text">Đóng góp</span>
                </a>
            </li>
            <li class="list" data-url="/home/bantochuc">
                <a href="/Home/BanToChuc">
                    <span class="icon"><i class="fas fa-users"></i></span>
                    <span class="text">Tổ chức</span>
                </a>
            </li>
            <li class="list" data-url="/home/tintuc">
                <a href="/Home/TinTuc">
                    <span class="icon"><i class="fas fa-newspaper"></i></span>
                    <span class="text">Tin tức</span>
                </a>
            </li>
            <div class="indicator" style="left: calc(21.4%);"></div>
        </ul>
    </div>

    <!-- FLOATING ACTION CART BUTTON (RESPONSIVE) -->
    <div id="floatingCartBtn" class="fixed right-5 bottom-24 md:bottom-8 z-40">
        <a asp-area="CuaHang" asp-controller="GioHang" asp-action="Index"
           class="flex items-center gap-2.5 px-4 py-3 rounded-full bg-gradient-to-r from-emerald-600 to-green-700 text-white shadow-xl hover:shadow-2xl hover:scale-105 active:scale-95 transition-all group border border-white/20"
           title="Xem giỏ quà gây quỹ">
            <i class="fas fa-shopping-basket text-lg animate-bounce group-hover:scale-110 transition-transform"></i>
            <span class="font-bold text-xs hidden sm:inline tracking-tight">Giỏ quà gây quỹ</span>
            <span id="floatingCartCount" class="w-6 h-6 rounded-full bg-rose-500 text-white font-black text-xs flex items-center justify-center shadow-xs">
                @cartCount
            </span>
        </a>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Đảm bảo không bị Dark mode ảnh hưởng
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
