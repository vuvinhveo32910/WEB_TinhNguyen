+// Middleware Session: BẮT BUỘC đặt sau UseRouting() và trước UseAuthorization()
+app.UseSession();
+
 app.UseAuthorization();
 
 app.MapStaticAssets();
 
+// Route cho Area (Cửa hàng gây quỹ & Admin Cửa hàng): Đặt TRƯỚC route mặc định
