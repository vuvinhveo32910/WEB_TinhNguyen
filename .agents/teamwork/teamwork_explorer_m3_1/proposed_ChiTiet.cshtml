@model WEB_TinhNguyen.Areas.CuaHang.Models.SanPhamGayQuy
@{
    ViewData["Title"] = Model.TenSanPham + " - Cửa Hàng Gây Quỹ";
    var relatedProducts = ViewBag.RelatedProducts as List<WEB_TinhNguyen.Areas.CuaHang.Models.SanPhamGayQuy> ?? new List<WEB_TinhNguyen.Areas.CuaHang.Models.SanPhamGayQuy>();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">

    <!-- BREADCRUMBS -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400 font-medium">
        <a href="/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition flex items-center gap-1">
            <i class="fas fa-home"></i> Trang chủ
        </a>
        <span>/</span>
        <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="Index" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition">
            Cửa hàng Gây Quỹ
        </a>
        <span>/</span>
        <span class="text-emerald-700 dark:text-emerald-400 font-semibold truncate max-w-xs sm:max-w-md">
            @Model.TenSanPham
        </span>
    </nav>

    <!-- FLASH MESSAGES -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="flex items-center justify-between p-4 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 shadow-sm animate-fade-in">
            <div class="flex items-center gap-3">
                <i class="fas fa-check-circle text-emerald-600 text-xl"></i>
                <span class="text-sm font-semibold">@TempData["SuccessMessage"]</span>
            </div>
            <a asp-area="CuaHang" asp-controller="GioHang" asp-action="Index" class="text-xs font-bold px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white transition">
                Xem giỏ hàng
            </a>
        </div>
    }

    <!-- MAIN PRODUCT DETAIL CARD: 2-COLUMN RESPONSIVE LAYOUT -->
    <div class="bg-white dark:bg-[#16261d] rounded-3xl p-6 sm:p-8 md:p-10 border border-gray-100 dark:border-white/10 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">

            <!-- LEFT COLUMN: PRODUCT IMAGE & TRUST COMMITMENTS (lg:col-span-5) -->
            <div class="lg:col-span-5 space-y-5">
                <!-- Large Image Container -->
                <div class="aspect-square rounded-3xl overflow-hidden bg-gray-50 dark:bg-night relative border border-gray-100 dark:border-white/10 shadow-inner group">
                    <img src="@(string.IsNullOrEmpty(Model.LinkHinhAnh) ? "/assets/default-product.jpg" : Model.LinkHinhAnh)"
                         alt="@Model.TenSanPham"
                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />

                    <!-- Floating Donation Tag -->
                    <div class="absolute top-4 left-4 z-10">
                        <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-black bg-rose-500/95 text-white backdrop-blur-md shadow-lg">
                            <i class="fas fa-heart animate-pulse"></i>
                            <span>100% Lợi Nhuận Gây Quỹ</span>
                        </span>
                    </div>

                    <!-- Category Floating Tag -->
                    <div class="absolute top-4 right-4 z-10">
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-black/60 text-white backdrop-blur-md">
                            @Model.DanhMuc
                        </span>
                    </div>
                </div>

                <!-- Trust Badges Strip -->
                <div class="grid grid-cols-3 gap-2 pt-2">
                    <div class="p-3 rounded-2xl bg-gray-50 dark:bg-night-2 border border-gray-100 dark:border-white/5 text-center">
                        <i class="fas fa-truck text-emerald-600 dark:text-emerald-400 text-base mb-1 block"></i>
                        <span class="text-[11px] font-bold text-gray-700 dark:text-gray-300 block">Giao toàn quốc</span>
                    </div>
                    <div class="p-3 rounded-2xl bg-gray-50 dark:bg-night-2 border border-gray-100 dark:border-white/5 text-center">
                        <i class="fas fa-hand-holding-heart text-rose-500 text-base mb-1 block"></i>
                        <span class="text-[11px] font-bold text-gray-700 dark:text-gray-300 block">Gây quỹ 100%</span>
                    </div>
                    <div class="p-3 rounded-2xl bg-gray-50 dark:bg-night-2 border border-gray-100 dark:border-white/5 text-center">
                        <i class="fas fa-shield-alt text-sky-500 text-base mb-1 block"></i>
                        <span class="text-[11px] font-bold text-gray-700 dark:text-gray-300 block">Minh bạch sao kê</span>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: DETAILS, MISSION & PURCHASE PANEL (lg:col-span-7) -->
            <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
                <div>
                    <!-- Category & Stock Status -->
                    <div class="flex items-center gap-3 mb-3 flex-wrap">
                        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                            @Model.DanhMuc
                        </span>

                        @if (Model.ConHang)
                        {
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-100 dark:bg-green-950/60 text-green-800 dark:text-green-300 border border-green-200 dark:border-green-800 flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-green-500 animate-ping"></span>
                                Còn hàng (@Model.SoLuongTon sản phẩm)
                            </span>
                        }
                        else
                        {
                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-rose-100 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                                Hết hàng
                            </span>
                        }

                        <span class="text-xs font-semibold text-gray-400">
                            Mã SP: #@Model.IDSanPham
                        </span>
                    </div>

                    <!-- Product Title -->
                    <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-gray-900 dark:text-white leading-tight tracking-tight mb-4">
                        @Model.TenSanPham
                    </h1>

                    <!-- Pricing Banner -->
                    <div class="flex items-baseline gap-3 p-4 rounded-2xl bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-100 dark:border-emerald-900/40 mb-6">
                        <span class="text-3xl sm:text-4xl font-black text-emerald-700 dark:text-emerald-400">
                            @Model.GiaBan.ToString("N0") VNĐ
                        </span>

                        @if (Model.GiaGoc.HasValue && Model.GiaGoc > Model.GiaBan)
                        {
                            <span class="text-base sm:text-lg text-gray-400 line-through">
                                @Model.GiaGoc.Value.ToString("N0") VNĐ
                            </span>
                            <span class="text-xs font-bold px-2 py-0.5 rounded-lg bg-rose-500 text-white">
                                Tiết kiệm @((Model.GiaGoc.Value - Model.GiaBan).ToString("N0"))₫
                            </span>
                        }
                    </div>

                    <!-- HUMANITARIAN CHARITY IMPACT CARD -->
                    <div class="p-5 rounded-2xl bg-gradient-to-br from-rose-50 via-amber-50/40 to-emerald-50/40 dark:from-rose-950/30 dark:via-night dark:to-emerald-950/20 border border-rose-200/80 dark:border-rose-900/40 shadow-sm space-y-3 mb-6">
                        <div class="flex items-center gap-2 text-rose-700 dark:text-rose-400 font-black text-xs uppercase tracking-wider">
                            <i class="fas fa-hand-holding-heart text-base animate-bounce"></i>
                            <span>Thông Điệp Gây Quỹ Tình Nguyện</span>
                        </div>

                        <p class="text-sm text-gray-800 dark:text-gray-200 font-medium leading-relaxed italic">
                            "@Model.ThongDiepGayQuy"
                        </p>

                        <div class="pt-2 border-t border-rose-200/50 dark:border-rose-900/30 flex items-center justify-between text-xs font-bold flex-wrap gap-2">
                            <span class="text-gray-600 dark:text-gray-400">
                                Tỷ lệ ủng hộ trực tiếp vào quỹ: <strong class="text-rose-600 dark:text-rose-400">@Model.PhanTramDongGop%</strong>
                            </span>
                            <span class="text-emerald-700 dark:text-emerald-400 bg-white/80 dark:bg-night-2 px-2.5 py-1 rounded-lg border border-emerald-200/60 dark:border-white/10">
                                Trích góp: <strong>@Model.TienDongGopTrenMoiSp.ToString("N0") VNĐ / sản phẩm</strong>
                            </span>
                        </div>
                    </div>

                    <!-- ADD TO CART & QUANTITY SELECTOR FORM -->
                    <form asp-area="CuaHang" asp-controller="GioHang" asp-action="ThemVaoGio" method="post" class="space-y-4 pt-2">
                        <input type="hidden" name="id" value="@Model.IDSanPham" />

                        <!-- Quantity Selector Controls -->
                        <div class="flex items-center gap-4">
                            <span class="text-sm font-bold text-gray-700 dark:text-gray-300">
                                Số lượng:
                            </span>

                            <div class="inline-flex items-center border border-gray-200 dark:border-white/10 rounded-xl bg-gray-50 dark:bg-night overflow-hidden shadow-inner">
                                <button type="button" onclick="adjustDetailQty(-1)"
                                        class="w-10 h-10 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-white/10 transition font-bold text-base focus:outline-none">
                                    -
                                </button>
                                <input type="number" id="detailQtyInput" name="soLuong" value="1" min="1" max="@Model.SoLuongTon"
                                       class="w-14 h-10 text-center font-bold text-sm bg-transparent border-0 focus:ring-0 dark:text-white" />
                                <button type="button" onclick="adjustDetailQty(1, @Model.SoLuongTon)"
                                        class="w-10 h-10 flex items-center justify-center text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-white/10 transition font-bold text-base focus:outline-none">
                                    +
                                </button>
                            </div>

                            <span class="text-xs text-gray-400">
                                (Tối đa @Model.SoLuongTon sản phẩm có sẵn)
                            </span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex flex-col sm:flex-row gap-3 pt-3">
                            @if (Model.ConHang)
                            {
                                <button type="submit"
                                        class="flex-1 inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl text-white font-black text-sm bg-gradient-to-r from-emerald-600 to-green-600 hover:from-emerald-500 hover:to-green-500 shadow-lg hover:shadow-xl transition transform active:scale-[0.98]">
                                    <i class="fas fa-cart-plus text-base"></i>
                                    <span>Thêm vào giỏ hàng</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" disabled
                                        class="flex-1 inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl text-gray-400 font-bold text-sm bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 cursor-not-allowed">
                                    <i class="fas fa-ban text-base"></i>
                                    <span>Sản phẩm tạm hết hàng</span>
                                </button>
                            }

                            <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="Index"
                               class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-white/10 hover:bg-gray-200 dark:hover:bg-white/15 font-bold text-sm transition">
                                <i class="fas fa-arrow-left"></i>
                                <span>Tiếp tục xem</span>
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>

        <!-- DETAILED DESCRIPTION SECTION (MoTaChiTiet) -->
        <div class="mt-12 pt-8 border-t border-gray-100 dark:border-white/10 space-y-4">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white flex items-center gap-2.5">
                <i class="fas fa-info-circle text-emerald-600 dark:text-emerald-400"></i>
                <span>Mô Tả Chi Tiết Sản Phẩm & Ý Nghĩa Gây Quỹ</span>
            </h2>

            <div class="prose dark:prose-invert max-w-none text-gray-600 dark:text-gray-300 text-sm leading-relaxed whitespace-pre-line bg-gray-50/50 dark:bg-night-2 p-6 rounded-2xl border border-gray-100 dark:border-white/5">
                @if (!string.IsNullOrEmpty(Model.MoTaChiTiet))
                {
                    @Model.MoTaChiTiet
                }
                else
                {
                    <p class="italic text-gray-400">Chưa có nội dung mô tả chi tiết cho sản phẩm này.</p>
                }
            </div>
        </div>
    </div>

    <!-- RELATED PRODUCTS SECTION -->
    @if (relatedProducts.Any())
    {
        <section class="space-y-6 pt-6">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl sm:text-2xl font-black text-gray-900 dark:text-white tracking-tight flex items-center gap-2">
                        <i class="fas fa-gift text-emerald-600 dark:text-emerald-400"></i>
                        <span>Sản Phẩm Gây Quỹ Khác</span>
                    </h3>
                    <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 mt-1">
                        Khám phá thêm các ấn phẩm gây quỹ giàu ý nghĩa của chiến dịch "Trăng Sáng Langbiang".
                    </p>
                </div>

                <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="Index"
                   class="text-xs sm:text-sm font-bold text-emerald-600 hover:text-emerald-700 dark:text-emerald-400 flex items-center gap-1 transition">
                    <span>Xem tất cả</span>
                    <i class="fas fa-arrow-right text-xs"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var rel in relatedProducts)
                {
                    <article class="group bg-white dark:bg-[#16261d] rounded-2xl border border-gray-100 dark:border-white/10 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col overflow-hidden relative">
                        <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="ChiTiet" asp-route-id="@rel.IDSanPham"
                           class="block aspect-square overflow-hidden bg-gray-50 dark:bg-night relative">
                            <img src="@(string.IsNullOrEmpty(rel.LinkHinhAnh) ? "/assets/default-product.jpg" : rel.LinkHinhAnh)"
                                 alt="@rel.TenSanPham"
                                 loading="lazy"
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            <span class="absolute top-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-rose-500 text-white shadow-sm">
                                ❤️ @rel.PhanTramDongGop% Quỹ
                            </span>
                        </a>

                        <div class="p-4 flex-1 flex flex-col justify-between space-y-2">
                            <div>
                                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                                    @rel.DanhMuc
                                </span>
                                <h4 class="text-sm font-bold text-gray-900 dark:text-white line-clamp-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition mt-0.5">
                                    <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="ChiTiet" asp-route-id="@rel.IDSanPham">
                                        @rel.TenSanPham
                                    </a>
                                </h4>
                            </div>

                            <div class="pt-2 border-t border-gray-100 dark:border-white/10 flex items-center justify-between">
                                <span class="text-sm font-black text-emerald-700 dark:text-emerald-400">
                                    @rel.GiaBan.ToString("N0") VNĐ
                                </span>
                                <a asp-area="CuaHang" asp-controller="CuaHang" asp-action="ChiTiet" asp-route-id="@rel.IDSanPham"
                                   class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
                                    Chi tiết &rarr;
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }

</div>

<!-- JAVASCRIPT: QUANTITY ADJUSTMENT HELPER -->
<script>
    function adjustDetailQty(delta, maxStock) {
        var input = document.getElementById('detailQtyInput');
        if (!input) return;
        var current = parseInt(input.value, 10) || 1;
        var next = current + delta;
        if (next < 1) next = 1;
        if (maxStock && next > maxStock) next = maxStock;
        input.value = next;
    }
</script>
